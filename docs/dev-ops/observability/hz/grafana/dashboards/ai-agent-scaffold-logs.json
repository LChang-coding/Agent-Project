    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "按时间正序展示event=rag_stage阶段事件。stage、outcome、inputCount、outputCount、costMs与traceId均在查询管道中由logfmt解析；traceId只用于过滤，不作为Loki标签。",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "id": 6,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Ascending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{job=\"ai-agent-scaffold\", filename=~\"$filename\"} |= \"event=rag_stage\" | logfmt | traceId=~\"$traceId\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "RAG阶段时间线（按Trace正序）",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "按stage统计RAG阶段耗时p50/p95。stage由logfmt查询时解析并分组；不会把traceId、tenantId、retrievalId或taskId提升为Loki标签。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 12,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 4,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "decimals": 0,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1000
              },
              {
                "color": "red",
                "value": 10000
              }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "id": 7,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.50, {job=\"ai-agent-scaffold\", filename=~\"$filename\"} |= \"event=rag_stage\" | logfmt | traceId=~\"$traceId\" | unwrap costMs | __error__=\"\" [$__interval]) by (stage)",
          "legendFormat": "p50 {{stage}}",
          "queryType": "range",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.95, {job=\"ai-agent-scaffold\", filename=~\"$filename\"} |= \"event=rag_stage\" | logfmt | traceId=~\"$traceId\" | unwrap costMs | __error__=\"\" [$__interval]) by (stage)",
          "legendFormat": "p95 {{stage}}",
          "queryType": "range",
          "refId": "B"
        }
      ],
      "title": "RAG阶段耗时 p50 / p95",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "汇总选定时间范围内各stage的inputCount与outputCount，用于识别Embedding、召回、融合、重排和Context预算阶段的候选收缩。计数缺失或无法解析的事件会被排除。",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
