      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (stage) (sum_over_time({job=\"ai-agent-scaffold\", filename=~\"$filename\"} |= \"event=rag_stage\" | logfmt | traceId=~\"$traceId\" | unwrap inputCount | __error__=\"\" [$__range]))",
          "legendFormat": "输入 {{stage}}",
          "queryType": "instant",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (stage) (sum_over_time({job=\"ai-agent-scaffold\", filename=~\"$filename\"} |= \"event=rag_stage\" | logfmt | traceId=~\"$traceId\" | unwrap outputCount | __error__=\"\" [$__range]))",
          "legendFormat": "输出 {{stage}}",
          "queryType": "instant",
          "refId": "B"
        }
      ],
      "title": "RAG候选漏斗（阶段输入 / 输出）",
      "type": "bargauge"
