# 复制为 .env 后替换全部 change-me；禁止提交真实值。
XXL_JOB_MYSQL_ROOT_PASSWORD=change-me-root
XXL_JOB_MYSQL_PASSWORD=change-me-app
XXL_JOB_ACCESS_TOKEN=change-me-long-random-token
XXL_JOB_ADMIN_PASSWORD=change-me-admin

# 服务器有反向代理时保持 127.0.0.1；需要直接访问时改为受防火墙保护的监听地址。
XXL_JOB_ADMIN_BIND_IP=127.0.0.1
XXL_JOB_ADMIN_PORT=8080
XXL_JOB_ADMIN_JAVA_OPTS=-Xms256m -Xmx512m
