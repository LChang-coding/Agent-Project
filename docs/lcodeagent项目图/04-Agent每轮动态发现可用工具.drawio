        <mxCell id="p3" parent="phase3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" value="是：加入 rag_retrieve&#xa;知识库范围来自服务端状态" vertex="1">
          <mxGeometry height="100" width="270" x="720" y="70" as="geometry" />
        </mxCell>
        <mxCell id="p4" parent="phase3" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" value="满足路由条件？&#xa;智能工作流 TOOL_V2、非终点&#xa;且当前节点存在合法出边" vertex="1">
          <mxGeometry height="130" width="290" x="1050" y="55" as="geometry" />
        </mxCell>
        <mxCell id="p5" parent="phase3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" value="是：加入 select_workflow_route&#xa;routeKey 枚举来自当前节点合法出边" vertex="1">
