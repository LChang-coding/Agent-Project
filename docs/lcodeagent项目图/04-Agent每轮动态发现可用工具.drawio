<mxfile host="Electron">
  <diagram id="dynamic-tools" name="Agent每轮动态发现可用工具">
    <mxGraphModel dx="2370" dy="1208" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3200" pageHeight="2150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F2937;" value="4. Agent 每轮动态发现可用工具" vertex="1">
          <mxGeometry height="40" width="1800" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4B5563;" value="每次模型请求前，系统依据可信身份、最新目录状态和当前节点范围重新生成工具清单；不在清单里的工具无法被模型调用。" vertex="1">
          <mxGeometry height="30" width="2600" x="40" y="60" as="geometry" />
        </mxCell>
        <mxCell id="phase1" parent="1" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#F4F8FF;strokeColor=#6C8EBF;strokeWidth=2;" value="① ChatService 写入本轮可信运行状态" vertex="1">
          <mxGeometry height="380" width="3100" x="40" y="110" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="phase1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" value="ChatService 准备执行&#xa;某个 Agent 节点" vertex="1">
          <mxGeometry height="90" width="260" x="30" y="80" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="phase1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" value="写入 ADK 只读运行状态&#xa;tenantId、userId、sessionId、runId&#xa;上下文版本和 traceId" vertex="1">
          <mxGeometry height="110" width="300" x="350" y="70" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="phase1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" value="智能工作流额外写入&#xa;当前 nodeId、nodeExecutionId、定义摘要&#xa;节点 Skill/MCP 范围、RAG 开关和合法路径" vertex="1">
          <mxGeometry height="130" width="340" x="710" y="60" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="phase1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;" value="ADK 在本轮请求模型前&#xa;调用 GatewayToolset.getTools" vertex="1">
          <mxGeometry height="100" width="300" x="1110" y="75" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="phase1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" value="GatewayToolset 只读取服务端状态&#xa;不读取模型生成的身份、节点或路径文本" vertex="1">
          <mxGeometry height="110" width="330" x="1470" y="70" as="geometry" />
        </mxCell>
        <mxCell id="s6" parent="phase1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" value="身份边界&#xa;模型不能提交 tenantId、userId 或 runId&#xa;来扩大工具查询范围" vertex="1">
          <mxGeometry height="110" width="380" x="1910" y="70" as="geometry" />
        </mxCell>
        <mxCell id="phase2" parent="1" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#FAF7FF;strokeColor=#9673A6;strokeWidth=2;" value="② ToolResolver 查最新目录并按权限、状态和节点范围过滤" vertex="1">
          <mxGeometry height="470" width="3100" x="40" y="520" as="geometry" />
        </mxCell>
        <mxCell id="d1" parent="phase2" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" value="检查 tenantId 和 userId 完整？" vertex="1">
          <mxGeometry height="110" width="240" x="30" y="65" as="geometry" />
        </mxCell>
        <mxCell id="d2" parent="phase2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" value="否：本轮装配失败&#xa;缺少隔离条件时不查询工具" vertex="1">
          <mxGeometry height="80" width="240" x="30" y="250" as="geometry" />
        </mxCell>
        <mxCell id="d3" parent="phase2" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" value="按 tenantId + userId 查询数据库&#xa;读取当前 Skill 和 MCP 目录" vertex="1">
          <mxGeometry height="100" width="290" x="330" y="70" as="geometry" />
        </mxCell>
        <mxCell id="d4" parent="phase2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" value="只保留当前用户有权使用、&#xa;已发布且存在激活版本的 Skill 和 MCP" vertex="1">
          <mxGeometry height="120" width="320" x="680" y="60" as="geometry" />
        </mxCell>
        <mxCell id="d5" parent="phase2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" value="按当前节点 skillIds / mcpIds&#xa;删除未配置的普通工具&#xa;静态与智能工作流都携带节点范围" vertex="1">
          <mxGeometry height="120" width="330" x="1060" y="60" as="geometry" />
        </mxCell>
        <mxCell id="d6" parent="phase2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" value="目录变化下一轮生效&#xa;刚发布、停用或权限变化&#xa;不需要重启应用或重新装配 Agent" vertex="1">
          <mxGeometry height="120" width="330" x="1450" y="60" as="geometry" />
        </mxCell>
        <mxCell id="d7" parent="phase2" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" value="性能边界&#xa;普通 Skill/MCP 清单当前不做 Java 内存缓存&#xa;目录很大时每轮查库会增加数据库压力" vertex="1">
          <mxGeometry height="120" width="430" x="1900" y="60" as="geometry" />
        </mxCell>
        <mxCell id="phase3" parent="1" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#FFF9F2;strokeColor=#D79B00;strokeWidth=2;" value="③ 按本轮运行条件临时加入平台工具" vertex="1">
          <mxGeometry height="430" width="3100" x="40" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="p1" parent="phase3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;fontStyle=1;" value="PlatformToolResolver&#xa;读取可信会话和节点条件" vertex="1">
          <mxGeometry height="100" width="270" x="30" y="70" as="geometry" />
        </mxCell>
        <mxCell id="p2" parent="phase3" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" value="满足 RAG 条件？&#xa;AGENT_TOOL 模式、RAG 未关闭、节点允许&#xa;且存在可信知识库范围" vertex="1">
          <mxGeometry height="130" width="300" x="360" y="55" as="geometry" />
