        <mxCell id="p7" parent="phase3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" value="是：删除其他全部工具&#xa;只保留 select_workflow_route&#xa;不能顺便再调用 MCP、Skill 或 RAG" vertex="1">
