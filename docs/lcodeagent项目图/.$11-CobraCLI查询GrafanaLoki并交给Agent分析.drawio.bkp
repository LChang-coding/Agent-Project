        <mxCell id="title" value="11. Cobra CLI 查询 Grafana/Loki 并交给 Agent 分析" style="text;html=1;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="80" y="30" width="1900" height="50" as="geometry"/></mxCell>
        <mxCell id="sub" value="从安全读取连接配置，到 Loki 精确查询、结果整理，再到 Agent 基于证据分析" style="text;html=1;align=left;fontSize=16;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="80" y="80" width="1800" height="30" as="geometry"/></mxCell>
