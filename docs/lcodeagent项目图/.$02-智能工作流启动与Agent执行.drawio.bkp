<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="31.0.2">
  <diagram id="workflow-start-agent" name="智能工作流启动与 Agent 执行">
    <mxGraphModel dx="3000" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3200" pageHeight="2100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="2. 智能工作流启动与 Agent 执行" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1600" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="本图范围：启动事务 → 提交后异步执行 → 当前节点的 Agent 尝试 → 终点收尾 / 交给路径处理 → SSE 观看。不展开下一节点的选择规则。" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="2400" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="phase1" value="① 请求受理与启动事务" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#F4F8FF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="3100" height="430" as="geometry"/>
        </mxCell>
        <mxCell id="p1" value="前端提交启动请求&#xa;workflowId / version / model&#xa;sessionId / 问题 / 附件 / requestedRunId" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="30" y="70" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="p2" value="Controller 从登录上下文取得&#xa;可信的租户、用户和角色&#xa;不接受请求伪造身份" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="350" y="70" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="p3" value="加载指定的已发布版本&#xa;校验它是智能工作流&#xa;得到定义摘要和预算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="650" y="70" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="p4" value="请求带有&#xa;sessionId？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="950" y="65" width="180" height="100" as="geometry"/></mxCell>
        <mxCell id="p5" value="无：创建工作流会话&#xa;保存本次生效的版本和模型&#xa;后续发布不会中途换配置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="1180" y="40" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="p6" value="有：检查会话访问权&#xa;并使用会话中已确定的&#xa;工作流版本和模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="1180" y="150" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="p7" value="startOrResume(requestedRunId)&#xa;创建或查询 chat_run&#xa;并查询智能工作流扩展状态" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="1510" y="70" width="270" height="100" as="geometry"/></mxCell>
        <mxCell id="p8" value="已有扩展状态？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="1830" y="70" width="190" height="100" as="geometry"/></mxCell>
        <mxCell id="p9" value="是：返回原运行&#xa;不重复写用户消息&#xa;不重复提交后台任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="2070" y="40" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="p10" value="否：同一事务写入&#xa;用户消息、附件关系&#xa;消息与本次运行的绑定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="2070" y="160" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="p11" value="创建扩展状态&#xa;currentNodeId=根节点，RUNNING&#xa;steps=0，tokens=0&#xa;保存版本、定义摘要和上限" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="2370" y="160" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="p12" value="保存 WORKFLOW_STARTED&#xa;事件带连续 sequence&#xa;事务提交后才提交后台任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="2680" y="160" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="p13" value="协调线程池接收？&#xa;默认：核心 1 / 最大 2 / 排队 8" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="phase1"><mxGeometry x="2650" y="285" width="190" height="100" as="geometry"/></mxCell>
        <mxCell id="p14" value="接收：HTTP 返回&#xa;runId / 运行根 traceId&#xa;本次请求 operationTraceId / 状态 / 预算&#xa;首次启动两个 Trace ID 通常相同" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="phase1"><mxGeometry x="2340" y="295" width="290" height="90" as="geometry"/></mxCell>
        <mxCell id="p15" value="拒绝：立即将运行改为 FAILED&#xa;写入失败终态事件&#xa;避免长期停留在 RUNNING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="2870" y="285" width="200" height="100" as="geometry"/></mxCell>

        <mxCell id="phase2" value="② 后台协调线程与节点循环保护" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#FAF7FF;strokeColor=#9673A6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="570" width="3100" height="350" as="geometry"/>
        </mxCell>
        <mxCell id="b1" value="使用运行根 traceId&#xa;继续后续日志和事件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="30" y="80" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="b2" value="把节点和边整理成&#xa;按 nodeId 快速查找的表&#xa;从 currentNodeId 开始" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="330" y="80" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="b3" value="每轮重新读取运行状态&#xa;已取消 / 已失败 / 已结束？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="640" y="65" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="b4" value="是：不再调用模型和工具&#xa;按当前终态收尾" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="650" y="210" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="b5" value="校验当前节点存在&#xa;增加该节点访问次数&#xa;此时尚不增加 executedSteps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="950" y="80" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="b6" value="该节点访问次数&#xa;超过 maxVisits？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="1250" y="65" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="b7" value="是：运行失败&#xa;防止单节点环路无限执行&#xa;旧定义默认 maxVisits=3&#xa;最终限制在 1~50" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="1240" y="210" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="b8" value="进入当前节点的一次 Agent 尝试&#xa;每次尝试都建立独立记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;" vertex="1" parent="phase2"><mxGeometry x="1540" y="80" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="b9" value="并发状态更新使用 revision 检查&#xa;冲突时重新读取并更新，最多 3 次&#xa;避免覆盖取消或其他请求的修改" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="1950" y="80" width="360" height="80" as="geometry"/></mxCell>
        <mxCell id="b10" value="能力边界&#xa;协调任务运行在单实例内存线程中&#xa;浏览器断线不会中止执行&#xa;应用进程重启后尚无 RUNNING 任务恢复链路" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="2420" y="70" width="430" height="100" as="geometry"/></mxCell>

        <mxCell id="phase3" value="③ 当前节点的一次 Agent 尝试" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#FFF9F2;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="950" width="3100" height="500" as="geometry"/>
        </mxCell>
        <mxCell id="a1" value="每次尝试都重新创建&#xa;nodeExecutionId&#xa;保存 RUNNING 节点审计&#xa;发布 NODE_STARTED" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="30" y="70" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="a2" value="合成当前节点提示词&#xa;用户问题 + 上一节点输出&#xa;节点要求 + 合法路径&#xa;+ RAG 使用说明" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="340" y="70" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="a3" value="先登记本次模型调用&#xa;相同调用编号不能重复执行" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="660" y="80" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="a4" value="根据节点和用户配置&#xa;为当前 Agent 动态准备可见工具&#xa;MCP / Skill / RAG / 路径建议工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="960" y="70" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="a5" value="调用当前节点对应的 Agent&#xa;消费完整事件流&#xa;Agent 可自主调用被允许的工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;" vertex="1" parent="phase3"><mxGeometry x="1280" y="70" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="a6" value="Agent 事件流&#xa;完整结束？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="1610" y="70" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="a7" value="是：模型调用记录成功&#xa;保存节点输出事件，executedSteps + 1&#xa;从统一用量账本汇总实际 Token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="1880" y="70" width="290" height="110" as="geometry"/></mxCell>
        <mxCell id="a8" value="重新检查执行结果&#xa;已取消 / 超过总步数或 Token 上限&#xa;/ 允许继续" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="phase3"><mxGeometry x="2220" y="65" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="a9" value="当前节点是否为终点&#xa;（没有下一条边）？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="2530" y="65" width="230" height="120" as="geometry"/></mxCell>
        <mxCell id="a10" value="否：Agent 调用已成功&#xa;交给第 3 张图确定下一节点&#xa;路径和状态同事务落库后才完成节点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontStyle=1;" vertex="1" parent="phase3"><mxGeometry x="2820" y="75" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="a11" value="否：记录模型调用和节点失败原因" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="1570" y="250" width="270" height="80" as="geometry"/></mxCell>
        <mxCell id="a12" value="先检查是否已取消&#xa;已取消直接进入下方取消收尾&#xa;否则判断是否为暂时性错误且未超过 3 次" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="phase3"><mxGeometry x="1890" y="235" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="a13" value="可重试：指数退避 500ms → 1000ms&#xa;等待期间持续检查取消&#xa;未取消才创建新的尝试记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="phase3"><mxGeometry x="2240" y="245" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="a14" value="否：不再重复调用&#xa;交给第 3 张图尝试 FAILURE 出口&#xa;失败出口可指向普通 Agent 继续执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="2540" y="245" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="a15" value="参数、权限等确定性错误不重试&#xa;重试只覆盖可能自行恢复的暂时性错误" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="1100" y="380" width="440" height="70" as="geometry"/></mxCell>

        <mxCell id="phase4" value="④ 终点收尾、失败 / 取消和 SSE 观看" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#F3FCF8;strokeColor=#67C9A3;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="1480" width="3100" height="540" as="geometry"/>
        </mxCell>
        <mxCell id="f1" value="终点前再检查一次&#xa;运行是否已被用户取消" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="30" y="70" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="f2" value="否：用最后节点输出作为最终回答&#xa;结合累计 RAG 证据检查引用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="320" y="80" width="290" height="90" as="geometry"/></mxCell>
        <mxCell id="f3" value="保存最终助手消息&#xa;chat_run → COMPLETED" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="660" y="80" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="f4" value="依次写入&#xa;FINAL_ANSWER_COMPLETED&#xa;WORKFLOW_COMPLETED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="960" y="80" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="f5" value="扩展状态更新为&#xa;currentNodeId=END&#xa;status=COMPLETED" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" vertex="1" parent="phase4"><mxGeometry x="1260" y="75" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="f6" value="取消收尾&#xa;结束仍 RUNNING 的节点记录&#xa;不保存错误回答&#xa;写 WORKFLOW_CANCELLED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="30" y="230" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="f7" value="最终失败收尾&#xa;无可用 FAILURE 出口或后续再出错&#xa;保存错误助手消息&#xa;写 WORKFLOW_FAILED，状态改为 FAILED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="360" y="230" width="330" height="100" as="geometry"/></mxCell>
        <mxCell id="f8" value="启动后持续写入运行事件&#xa;所有事件使用连续 sequence&#xa;节点开始 / 输出 / 路径 / 终态都可查询" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="800" y="235" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="f9" value="前端拿到启动响应后即可订阅 SSE&#xa;每次只推送 afterSequence 之后的内容&#xa;收到终态事件后结束本次观看" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="1150" y="230" width="330" height="110" as="geometry"/></mxCell>
        <mxCell id="f10" value="断线后重连&#xa;客户端带上最后收到的 sequence&#xa;先补齐遗漏事件，再继续观看" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="1530" y="240" width="310" height="90" as="geometry"/></mxCell>
        <mxCell id="f11" value="完成 / 30 分钟超时 / 网络断开&#xa;只释放本次 SSE 订阅和轮询任务&#xa;不取消已在后台执行的工作流" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="1890" y="230" width="340" height="110" as="geometry"/></mxCell>
        <mxCell id="legend" value="图例" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9CA3AF;verticalAlign=top;fontStyle=1;fontSize=13;container=1;pointerEvents=0;" vertex="1" parent="phase4"><mxGeometry x="2400" y="210" width="620" height="170" as="geometry"/></mxCell>
        <mxCell id="lg1" value="入口 / 服务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="legend"><mxGeometry x="20" y="40" width="130" height="35" as="geometry"/></mxCell>
        <mxCell id="lg2" value="持久化 / 成功" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="legend"><mxGeometry x="170" y="40" width="130" height="35" as="geometry"/></mxCell>
        <mxCell id="lg3" value="Agent / 模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="legend"><mxGeometry x="320" y="40" width="130" height="35" as="geometry"/></mxCell>
