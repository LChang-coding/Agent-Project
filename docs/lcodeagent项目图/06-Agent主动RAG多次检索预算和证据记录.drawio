        </mxCell>
        <mxCell id="c6" parent="phase3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" value="再次调用仍从预算检查开始&#xa;不是代码硬编码的第二次检索&#xa;达到次数或 Token 上限后会被拒绝" vertex="1">
          <mxGeometry height="100" width="310" x="1370" y="175" as="geometry" />
