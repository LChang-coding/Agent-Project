        </mxCell>
        <mxCell id="c1" parent="phase3" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" value="按 tenant + user + session + run&#xa;+ 本次模型调用编号&#xa;记录真正交给模型的证据" vertex="1">
          <mxGeometry height="105" width="300" x="30" y="75" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="phase3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" value="返回给 Agent&#xa;context / citations / 命中数&#xa;Token / 耗时 / 是否降级" vertex="1">
          <mxGeometry height="105" width="280" x="390" y="75" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="phase3" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" value="资料是否足够回答？" vertex="1">
          <mxGeometry height="105" width="230" x="730" y="75" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="phase3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" value="足够：继续生成答案&#xa;引用需要使用返回的 citationId" vertex="1">
          <mxGeometry height="90" width="280" x="1020" y="55" as="geometry" />
        </mxCell>
        <mxCell id="c5" parent="phase3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;" value="不足或发现新线索：&#xa;Agent 自己换成更具体的问题&#xa;再次调用 rag_retrieve" vertex="1">
