        <mxCell id="c7" parent="phase3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" value="节点结束时只取回&#xa;该模型调用编号下实际登记的证据&#xa;不会把其他运行资料混进来" vertex="1">
