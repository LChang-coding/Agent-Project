<mxfile host="Electron">
  <diagram id="agent-rag-budget-evidence" name="Agent主动RAG多次检索预算和证据记录">
    <mxGraphModel dx="2917" dy="1486" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3200" pageHeight="2050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F2937;" value="6. Agent 主动 RAG：多次检索、预算控制和证据记录" vertex="1">
          <mxGeometry height="40" width="1900" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4B5563;" value="本图范围：本轮发现 rag_retrieve → Agent 自主决定检索次数 → 先占预算再按实际使用结算 → 记录真正交给模型的证据 → 最终回答检查引用。" vertex="1">
          <mxGeometry height="30" width="2650" x="40" y="60" as="geometry" />
        </mxCell>
        <mxCell id="phase1" parent="1" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#F4F8FF;strokeColor=#6C8EBF;strokeWidth=2;" value="① 本轮是否向 Agent 提供 RAG 工具" vertex="1">
          <mxGeometry height="350" width="3100" x="40" y="110" as="geometry" />
        </mxCell>
        <mxCell id="a1" parent="phase1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" value="本次会话采用 AGENT_TOOL&#xa;RAG 没有关闭&#xa;当前 Agent 节点允许检索" vertex="1">
          <mxGeometry height="90" width="270" x="30" y="75" as="geometry" />
        </mxCell>
        <mxCell id="a2" parent="phase1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" value="PlatformToolResolver&#xa;把 rag_retrieve 加入&#xa;这一轮可见工具清单" vertex="1">
          <mxGeometry height="90" width="250" x="350" y="75" as="geometry" />
        </mxCell>
        <mxCell id="a3" parent="phase1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;" value="Agent 根据用户问题和已有结果&#xa;自主判断现在是否需要检索&#xa;系统不强制一定调用" vertex="1">
          <mxGeometry height="100" width="300" x="650" y="70" as="geometry" />
        </mxCell>
        <mxCell id="a4" parent="phase1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" value="调用 rag_retrieve&#xa;模型只能提交 query&#xa;和可选 maxContextTokens" vertex="1">
          <mxGeometry height="90" width="260" x="1000" y="75" as="geometry" />
        </mxCell>
        <mxCell id="a5" parent="phase1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" value="参数范围检查&#xa;query 最长 2000 字符&#xa;Token：128~8000，默认 8000" vertex="1">
          <mxGeometry height="110" width="250" x="1320" y="65" as="geometry" />
        </mxCell>
        <mxCell id="a6" parent="phase1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" value="身份和知识库范围全部来自&#xa;服务端本次运行保存的信息&#xa;模型不能切换租户、用户或 bindingIds" vertex="1">
          <mxGeometry height="100" width="320" x="1630" y="70" as="geometry" />
        </mxCell>
        <mxCell id="a7" parent="phase1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" value="Tool Gateway 统一处理&#xa;运行是否可继续 / 重复调用保护&#xa;开始、成功和失败审计" vertex="1">
          <mxGeometry height="100" width="300" x="2010" y="70" as="geometry" />
        </mxCell>
        <mxCell id="a8" parent="phase1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" value="参数不合法或运行已结束&#xa;返回明确错误&#xa;不会进入检索服务" vertex="1">
          <mxGeometry height="100" width="270" x="2380" y="70" as="geometry" />
        </mxCell>
        <mxCell id="a9" parent="phase1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" value="工具可用并通过检查&#xa;进入预算与检索阶段" vertex="1">
          <mxGeometry height="90" width="260" x="2720" y="75" as="geometry" />
        </mxCell>
        <mxCell id="phase2" parent="1" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#FFF9F2;strokeColor=#D79B00;strokeWidth=2;" value="② 先占住预算，再同步完成检索" vertex="1">
          <mxGeometry height="420" width="3100" x="40" y="490" as="geometry" />
        </mxCell>
        <mxCell id="b1" parent="phase2" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" value="按 tenant + user + run&#xa;先占 1 次调用和本次最大 Token&#xa;并发检索也先各自占住额度" vertex="1">
          <mxGeometry height="105" width="280" x="30" y="75" as="geometry" />
        </mxCell>
        <mxCell id="b2" parent="phase2" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" value="本次 Run 仍有额度？&#xa;默认最多 3 次检索&#xa;累计最多 8000 Token" vertex="1">
          <mxGeometry height="115" width="250" x="370" y="70" as="geometry" />
        </mxCell>
        <mxCell id="b3" parent="phase2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" value="否：RAG_TOOL_BUDGET_EXCEEDED&#xa;不调用 Embedding / Qdrant / Rerank&#xa;Agent 只能使用已有资料继续作答" vertex="1">
          <mxGeometry height="100" width="290" x="350" y="235" as="geometry" />
        </mxCell>
        <mxCell id="b4" parent="phase2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" value="RagRetrievalService&#xa;只在本次运行保存的绑定范围内&#xa;完成召回、融合和重排" vertex="1">
          <mxGeometry height="105" width="290" x="690" y="75" as="geometry" />
        </mxCell>
        <mxCell id="b5" parent="phase2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" value="补充父块和相邻块&#xa;按完整引用计算上下文 Token&#xa;不返回无法核对出处的半段资料" vertex="1">
          <mxGeometry height="105" width="300" x="1030" y="75" as="geometry" />
        </mxCell>
        <mxCell id="b6" parent="phase2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" value="PresentationService 包装资料&#xa;标明它们只是参考内容&#xa;文档中的命令没有指令权限" vertex="1">
          <mxGeometry height="105" width="300" x="1380" y="75" as="geometry" />
        </mxCell>
        <mxCell id="b7" parent="phase2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" value="转义 XML 特殊字符&#xa;每条资料携带平台生成的 citationId&#xa;防止正文改变提示词结构" vertex="1">
          <mxGeometry height="105" width="300" x="1730" y="75" as="geometry" />
        </mxCell>
        <mxCell id="b8" parent="phase2" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" value="检索期间是否被取消？" vertex="1">
          <mxGeometry height="105" width="230" x="2090" y="75" as="geometry" />
        </mxCell>
        <mxCell id="b9" parent="phase2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" value="已取消：丢弃迟到结果&#xa;不登记为可引用证据&#xa;归还本次预算" vertex="1">
          <mxGeometry height="95" width="250" x="2080" y="235" as="geometry" />
        </mxCell>
        <mxCell id="b10" parent="phase2" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" value="未取消：按实际返回 Token 结算&#xa;归还预留但未使用的差额&#xa;空结果仍算一次成功检索" vertex="1">
          <mxGeometry height="105" width="300" x="2380" y="75" as="geometry" />
        </mxCell>
        <mxCell id="b11" parent="phase2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" value="参数错误或检索异常&#xa;调用次数和 Token 预留都归还&#xa;不会消耗本次 Run 的有效额度" vertex="1">
          <mxGeometry height="105" width="300" x="2720" y="75" as="geometry" />
        </mxCell>
        <mxCell id="phase3" parent="1" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#FAF7FF;strokeColor=#9673A6;strokeWidth=2;" value="③ 记录证据，Agent 根据结果决定是否继续检索" vertex="1">
