<?xml version='1.0' encoding='UTF-8'?>
<mxfile host="Electron" modified="2026-08-14T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="overview-02" name="01-领域总览与表职责">
    <mxGraphModel dx="2500" dy="970" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="970" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="租户、用户与 Agent 工具配置：表职责与业务链路" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=30;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="44" y="20" width="2412" height="44" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="管理平台身份边界、租户成员关系、Agent 租户覆盖，以及 Skill/MCP 的发布版本。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="46" y="68" width="2408" height="38" as="geometry" />
        </mxCell>
        <mxCell id="flows" value="&lt;div style='text-align:left;line-height:1.65'&gt;&lt;b style='font-size:18px'&gt;核心业务链路&lt;/b&gt;&lt;br&gt;身份链：tenant → tenant_user → user_account → user_secret&lt;br&gt;Skill 发布链：skill_definition → skill_version → Runtime Tool Resolver&lt;br&gt;MCP 发布链：mcp_server_config → mcp_config_version → Runtime Connector&lt;br&gt;Agent 覆盖链：Runtime/YAML Agent Registry → agent_tenant_override&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9fafb;strokeColor=#6b7280;fontSize=15;align=left;verticalAlign=middle;spacing=14;dashed=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="120" width="2390" height="160" as="geometry" />
        </mxCell>
        <mxCell id="purpose_tenant" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;tenant&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;平台租户根实体；所有租户级数据都通过 tenant_id 与它建立逻辑归属。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;租户创建与管理服务&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;认证、授权及所有租户隔离查询&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;active → disabled；删除使用 deleted 软删除&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="310" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_user_account" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;user_account&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;保存平台用户公开资料和账户状态，不保存密码明文。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;注册与用户资料服务&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;登录、租户成员和会话归属校验&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;active → disabled；资料可持续更新&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="870" y="310" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_tenant_user" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;tenant_user&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;连接租户和用户，并固化 owner/admin/developer/member 等租户角色。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;租户成员管理服务&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;权限判断和租户数据范围过滤&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;加入租户 → active；禁用后停止租户权限&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1685" y="310" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_user_secret" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;user_secret&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;保存密码哈希、API Key 或 OAuth 等认证凭证。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;注册、改密和凭证管理服务&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;认证服务&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;active → disabled/expired；按 user_id + secret_type 唯一&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="515" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_skill_definition" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;skill_definition&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;保存一个 Skill 的稳定身份、展示信息和当前/已发布版本指针。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;Skill 管理与发布服务&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;工具目录和 Runtime Tool Resolver&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;draft 编辑 → published_version 生效 → disabled&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="870" y="515" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_skill_version" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;skill_version&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;保存 Skill 每次发布的不可变包位置、协议、校验摘要和测试结果。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;Skill 版本发布服务&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;Runtime 装载指定版本和回放历史运行&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;版本创建 → 测试 → published；历史版本保留&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1685" y="515" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_mcp_server_config" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;mcp_server_config&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;保存 MCP 服务稳定身份、连接方式和当前/已发布版本指针。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;MCP 配置管理服务&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;工具目录和 MCP 连接器&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;编辑 → 测试 → 发布 → active_version 生效&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="720" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_mcp_config_version" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;mcp_config_version&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;保存一次不可变 MCP 端点、命令、环境和工具 Schema 快照。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;MCP 版本发布服务&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;运行时连接器和历史运行回放&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;版本创建 → 测试 → published；旧版本不覆盖&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="870" y="720" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_agent_tenant_override" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;agent_tenant_override&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;保存某租户对 Runtime/YAML Agent 的启停、显示和权限覆盖，不保存 Agent 基础定义。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;Agent 租户配置服务&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;Agent Runtime 注册表合并器&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;创建覆盖 → 更新 revision → disabled/deleted&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1685" y="720" width="760" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="detail-02-2" name="02-tenant + user_account">
    <mxGraphModel dx="2420" dy="1232" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="1232" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="租户、用户与 Agent 工具配置：字段明细" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=30;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="44" y="20" width="2332" height="44" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="每页只展示 1–2 张表；先解释业务职责，再列完整字段、状态枚举、主键、唯一键和索引。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="46" y="68" width="2328" height="38" as="geometry" />
        </mxCell>
        <mxCell id="purpose_tenant" value="&lt;div style='text-align:left;line-height:1.55'&gt;&lt;b style='font-size:20px'&gt;tenant&lt;/b&gt;&lt;br&gt;&lt;b&gt;这张表解决什么：&lt;/b&gt;平台租户根实体；所有租户级数据都通过 tenant_id 与它建立逻辑归属。&lt;br&gt;&lt;b&gt;谁写入：&lt;/b&gt;租户创建与管理服务　　&lt;b&gt;谁读取：&lt;/b&gt;认证、授权及所有租户隔离查询&lt;br&gt;&lt;b&gt;关键生命周期：&lt;/b&gt;active → disabled；删除使用 deleted 软删除&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=left;verticalAlign=middle;spacing=16;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="125" width="1120" height="150" as="geometry" />
        </mxCell>
        <mxCell id="table_tenant" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;b style='font-size:21px'&gt;tenant&lt;/b&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;tenant&lt;/span&gt;&lt;hr&gt;&lt;b&gt;字段&lt;/b&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[PK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主键（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;tenant_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租户业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;tenant_name&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租户名称（NOT NULL，默认 &amp;#x27;&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;tenant_code&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租户编码（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;status&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租户状态：active/disabled；active=启用；disabled=停用（NOT NULL，默认 &amp;#x27;active&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;metadata&lt;/b&gt; &lt;span style='color:#2563eb'&gt;JSON NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　扩展信息（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;create_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　创建时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;update_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　更新时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;deleted&lt;/b&gt; &lt;span style='color:#2563eb'&gt;TINYINT(1)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　删除标记，0未删除，1已删除（NOT NULL，默认 0）&lt;/span&gt;&lt;hr&gt;&lt;b&gt;约束与索引&lt;/b&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;PK(id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_tenant_id(tenant_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_tenant_code(tenant_code)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_tenant_status(status)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;align=left;verticalAlign=top;spacing=18;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="55" y="305" width="1120" height="656" as="geometry" />
        </mxCell>
        <mxCell id="purpose_user_account" value="&lt;div style='text-align:left;line-height:1.55'&gt;&lt;b style='font-size:20px'&gt;user_account&lt;/b&gt;&lt;br&gt;&lt;b&gt;这张表解决什么：&lt;/b&gt;保存平台用户公开资料和账户状态，不保存密码明文。&lt;br&gt;&lt;b&gt;谁写入：&lt;/b&gt;注册与用户资料服务　　&lt;b&gt;谁读取：&lt;/b&gt;登录、租户成员和会话归属校验&lt;br&gt;&lt;b&gt;关键生命周期：&lt;/b&gt;active → disabled；资料可持续更新&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=left;verticalAlign=middle;spacing=16;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1245" y="125" width="1120" height="150" as="geometry" />
        </mxCell>
        <mxCell id="table_user_account" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;b style='font-size:21px'&gt;user_account&lt;/b&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;user_account&lt;/span&gt;&lt;hr&gt;&lt;b&gt;字段&lt;/b&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[PK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主键（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;user_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　用户业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;username&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　用户名（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;nickname&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　昵称（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;email&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(255)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　邮箱（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;phone&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　手机号（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;avatar&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(512)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　头像地址（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;status&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　用户状态：active/disabled；active=启用；disabled=停用（NOT NULL，默认 &amp;#x27;active&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;metadata&lt;/b&gt; &lt;span style='color:#2563eb'&gt;JSON NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　扩展信息（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;create_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　创建时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;update_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　更新时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;deleted&lt;/b&gt; &lt;span style='color:#2563eb'&gt;TINYINT(1)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　删除标记，0未删除，1已删除（NOT NULL，默认 0）&lt;/span&gt;&lt;hr&gt;&lt;b&gt;约束与索引&lt;/b&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;PK(id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_user_id(user_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_username(username)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_email(email)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_phone(phone)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_user_status(status)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;align=left;verticalAlign=top;spacing=18;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1245" y="305" width="1120" height="832" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
