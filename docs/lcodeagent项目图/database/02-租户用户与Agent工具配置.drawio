  <diagram id="detail-02-3" name="03-tenant_user + user_secret">
    <mxGraphModel dx="2420" dy="1188" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="1188" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="租户、用户与 Agent 工具配置：字段明细" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=30;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="44" y="20" width="2332" height="44" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="每页只展示 1–2 张表；先解释业务职责，再列完整字段、状态枚举、主键、唯一键和索引。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="46" y="68" width="2328" height="38" as="geometry" />
        </mxCell>
        <mxCell id="purpose_tenant_user" value="&lt;div style='text-align:left;line-height:1.55'&gt;&lt;b style='font-size:20px'&gt;tenant_user&lt;/b&gt;&lt;br&gt;&lt;b&gt;这张表解决什么：&lt;/b&gt;连接租户和用户，并固化 owner/admin/developer/member 等租户角色。&lt;br&gt;&lt;b&gt;谁写入：&lt;/b&gt;租户成员管理服务　　&lt;b&gt;谁读取：&lt;/b&gt;权限判断和租户数据范围过滤&lt;br&gt;&lt;b&gt;关键生命周期：&lt;/b&gt;加入租户 → active；禁用后停止租户权限&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=left;verticalAlign=middle;spacing=16;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="125" width="1120" height="150" as="geometry" />
        </mxCell>
        <mxCell id="table_tenant_user" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;b style='font-size:21px'&gt;tenant_user&lt;/b&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;tenant_user&lt;/span&gt;&lt;hr&gt;&lt;b&gt;字段&lt;/b&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[PK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主键（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;tenant_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK] [REF]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租户业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;user_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK] [REF]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　用户业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;role_code&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租户角色：owner/admin/developer/member（NOT NULL，默认 &amp;#x27;member&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;status&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　关系状态：active/disabled（NOT NULL，默认 &amp;#x27;active&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;joined_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　加入租户时间（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;metadata&lt;/b&gt; &lt;span style='color:#2563eb'&gt;JSON NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　扩展信息（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;create_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　创建时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;update_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　更新时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;deleted&lt;/b&gt; &lt;span style='color:#2563eb'&gt;TINYINT(1)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　删除标记，0未删除，1已删除（NOT NULL，默认 0）&lt;/span&gt;&lt;hr&gt;&lt;b&gt;约束与索引&lt;/b&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;PK(id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_tenant_user(tenant_id, user_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_tenant_user_tenant_role(tenant_id, role_code)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_tenant_user_user(user_id)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;align=left;verticalAlign=top;spacing=18;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="55" y="305" width="1120" height="700" as="geometry" />
        </mxCell>
        <mxCell id="purpose_user_secret" value="&lt;div style='text-align:left;line-height:1.55'&gt;&lt;b style='font-size:20px'&gt;user_secret&lt;/b&gt;&lt;br&gt;&lt;b&gt;这张表解决什么：&lt;/b&gt;保存密码哈希、API Key 或 OAuth 等认证凭证。&lt;br&gt;&lt;b&gt;谁写入：&lt;/b&gt;注册、改密和凭证管理服务　　&lt;b&gt;谁读取：&lt;/b&gt;认证服务&lt;br&gt;&lt;b&gt;关键生命周期：&lt;/b&gt;active → disabled/expired；按 user_id + secret_type 唯一&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=left;verticalAlign=middle;spacing=16;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1245" y="125" width="1120" height="150" as="geometry" />
        </mxCell>
        <mxCell id="table_user_secret" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;b style='font-size:21px'&gt;user_secret&lt;/b&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;user_secret&lt;/span&gt;&lt;hr&gt;&lt;b&gt;字段&lt;/b&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[PK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主键（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;tenant_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租户业务ID，个体户可为空（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;user_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK] [REF]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　用户业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;secret_type&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　凭证类型：password/api_key/oauth（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;secret_value_hash&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(255)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　凭证密文或哈希值（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;salt&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　密码盐值（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;expire_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　凭证过期时间（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;status&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　凭证状态：active/disabled/expired；active=有效；disabled=停用；expired=过期（NOT NULL，默认 &amp;#x27;active&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;metadata&lt;/b&gt; &lt;span style='color:#2563eb'&gt;JSON NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　扩展信息（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;create_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　创建时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;update_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　更新时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;deleted&lt;/b&gt; &lt;span style='color:#2563eb'&gt;TINYINT(1)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　删除标记，0未删除，1已删除（NOT NULL，默认 0）&lt;/span&gt;&lt;hr&gt;&lt;b&gt;约束与索引&lt;/b&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;PK(id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_user_secret_type(user_id, secret_type)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_user_secret_tenant(tenant_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_user_secret_status(status)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;align=left;verticalAlign=top;spacing=18;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1245" y="305" width="1120" height="788" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="detail-02-4" name="04-skill_definition + skill_version">
    <mxGraphModel dx="2420" dy="1518" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="1518" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="租户、用户与 Agent 工具配置：字段明细" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=30;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="44" y="20" width="2332" height="44" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="每页只展示 1–2 张表；先解释业务职责，再列完整字段、状态枚举、主键、唯一键和索引。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="46" y="68" width="2328" height="38" as="geometry" />
        </mxCell>
        <mxCell id="purpose_skill_definition" value="&lt;div style='text-align:left;line-height:1.55'&gt;&lt;b style='font-size:20px'&gt;skill_definition&lt;/b&gt;&lt;br&gt;&lt;b&gt;这张表解决什么：&lt;/b&gt;保存一个 Skill 的稳定身份、展示信息和当前/已发布版本指针。&lt;br&gt;&lt;b&gt;谁写入：&lt;/b&gt;Skill 管理与发布服务　　&lt;b&gt;谁读取：&lt;/b&gt;工具目录和 Runtime Tool Resolver&lt;br&gt;&lt;b&gt;关键生命周期：&lt;/b&gt;draft 编辑 → published_version 生效 → disabled&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=left;verticalAlign=middle;spacing=16;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="125" width="1120" height="150" as="geometry" />
        </mxCell>
        <mxCell id="table_skill_definition" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;b style='font-size:21px'&gt;skill_definition&lt;/b&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;skill_definition&lt;/span&gt;&lt;hr&gt;&lt;b&gt;字段&lt;/b&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[PK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主键（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;tenant_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租户业务ID，个体户可为空（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;owner_user_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　Skill 拥有者用户ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;visibility&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　可见范围：private/tenant_public（NOT NULL，默认 &amp;#x27;private&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;skill_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　Skill 业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;skill_name&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　Skill 名称（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;skill_code&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　Skill 编码（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;description&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(512)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　Skill 描述（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;source_type&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　来源类型：builtin/upload/git/markdown（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;source_uri&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(512)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　来源地址（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;version&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　版本号（NOT NULL，默认 &amp;#x27;1.0.0&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;current_version&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　当前最新编辑版本号（NOT NULL，默认 &amp;#x27;&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;published_version&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　当前已发布版本号（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;active_version_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　当前运行生效的版本标识（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;status&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　Skill 状态：draft/active/disabled/archived/pending_review（NOT NULL，默认 &amp;#x27;draft&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;metadata&lt;/b&gt; &lt;span style='color:#2563eb'&gt;JSON NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　扩展信息（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;create_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　创建时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;update_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　更新时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;deleted&lt;/b&gt; &lt;span style='color:#2563eb'&gt;TINYINT(1)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　删除标记，0未删除，1已删除（NOT NULL，默认 0）&lt;/span&gt;&lt;hr&gt;&lt;b&gt;约束与索引&lt;/b&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;PK(id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_skill_id(skill_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_skill_code_version(tenant_id, skill_code, version)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_skill_owner(owner_user_id, create_time)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_skill_tenant_visibility(tenant_id, visibility, status)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;align=left;verticalAlign=top;spacing=18;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="55" y="305" width="1120" height="1118" as="geometry" />
        </mxCell>
        <mxCell id="purpose_skill_version" value="&lt;div style='text-align:left;line-height:1.55'&gt;&lt;b style='font-size:20px'&gt;skill_version&lt;/b&gt;&lt;br&gt;&lt;b&gt;这张表解决什么：&lt;/b&gt;保存 Skill 每次发布的不可变包位置、协议、校验摘要和测试结果。&lt;br&gt;&lt;b&gt;谁写入：&lt;/b&gt;Skill 版本发布服务　　&lt;b&gt;谁读取：&lt;/b&gt;Runtime 装载指定版本和回放历史运行&lt;br&gt;&lt;b&gt;关键生命周期：&lt;/b&gt;版本创建 → 测试 → published；历史版本保留&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;align=left;verticalAlign=middle;spacing=16;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1245" y="125" width="1120" height="150" as="geometry" />
        </mxCell>
        <mxCell id="table_skill_version" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;b style='font-size:21px'&gt;skill_version&lt;/b&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;skill_version&lt;/span&gt;&lt;hr&gt;&lt;b&gt;字段&lt;/b&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[PK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主键（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;tenant_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租户业务ID，个体户可为空（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;owner_user_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　版本发布用户ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;skill_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK] [REF]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　Skill 业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;version_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　Skill 版本业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;version&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　版本号（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;asset_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　关联 artifact_asset 业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;bucket&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　Skill 包对象存储桶（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;object_key&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(512)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　Skill 包对象 Key（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;file_name&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(255)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　原始文件名（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;sha256&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　文件 SHA-256 摘要（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;size_bytes&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　文件大小，单位字节（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;manifest_json&lt;/b&gt; &lt;span style='color:#2563eb'&gt;JSON NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　SKILL.md front matter 或解析结果（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;status&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　版本状态：draft/active/disabled/archived（NOT NULL，默认 &amp;#x27;draft&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;metadata&lt;/b&gt; &lt;span style='color:#2563eb'&gt;JSON NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　扩展信息（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;create_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　创建时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;update_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　更新时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;deleted&lt;/b&gt; &lt;span style='color:#2563eb'&gt;TINYINT(1)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　删除标记，0未删除，1已删除（NOT NULL，默认 0）&lt;/span&gt;&lt;hr&gt;&lt;b&gt;约束与索引&lt;/b&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;PK(id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_skill_version_id(version_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_skill_version(skill_id, version)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_skill_version_skill(tenant_id, skill_id, status)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_skill_version_asset(asset_id)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;align=left;verticalAlign=top;spacing=18;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1245" y="305" width="1120" height="1074" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
