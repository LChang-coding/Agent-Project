<?xml version='1.0' encoding='UTF-8'?>
<mxfile host="Electron" modified="2026-08-14T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="overview-08" name="01-领域总览与表职责">
    <mxGraphModel dx="2500" dy="765" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="765" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="多 Agent 编排、回调与清理：表职责与业务链路" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=30;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="44" y="20" width="2412" height="44" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="让主 Agent 动态创建临时子 Agent，可靠分发任务、回调摘要、单飞续跑并在业务 ACK 后清理实例。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="46" y="68" width="2408" height="38" as="geometry" />
        </mxCell>
        <mxCell id="flows" value="&lt;div style='text-align:left;line-height:1.65'&gt;&lt;b style='font-size:18px'&gt;核心业务链路&lt;/b&gt;&lt;br&gt;创建链：主 chat_run → agent_subagent_task + agent_orchestration_outbox → Kafka&lt;br&gt;执行链：Worker Lease → child_session → 子 Agent → result_summary/full_context&lt;br&gt;回调链：agent_parent_inbox → agent_parent_resume_request → 主 Agent 新内部 Run&lt;br&gt;确认链：Inbox consumed + Task ACKED → Cleanup Outbox → 删除临时会话和 Redis 缓存&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9fafb;strokeColor=#6b7280;fontSize=15;align=left;verticalAlign=middle;spacing=14;dashed=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="120" width="2390" height="160" as="geometry" />
        </mxCell>
        <mxCell id="purpose_agent_subagent_task" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;agent_subagent_task&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;保存主 Agent 创建的每个子任务、Worker 租约、子会话、两级结果和回调状态。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;SubagentOrchestrationService 与子 Agent Worker&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;任务查询、结果回调、完整上下文读取和清理器&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;READY → RUNNING → SUCCEEDED/FAILED/CANCELLED → ACKED；回调独立推进至 DELIVERED&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4f4ee;strokeColor=#3bbf8a;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="310" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_agent_parent_inbox" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;agent_parent_inbox&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;为主 Run 持久保存每个子任务的结果摘要和到达顺序，避免回调消息丢失。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;Result Callback Consumer&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;Parent Resume Worker&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;每个 parent_run + task 唯一；消费后写 consumed_at&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4f4ee;strokeColor=#3bbf8a;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="870" y="310" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_agent_parent_resume_request" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;agent_parent_resume_request&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;合并同一主 Run 的多个结果唤醒，并用 requested/processed version 保证续跑期间新结果不丢。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;结果回调登记事务&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;Parent Resume Consumer 与恢复扫描器&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;PENDING → RUNNING → COMPLETED；新结果到达重新 PENDING；失败 RETRYING/DEAD&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4f4ee;strokeColor=#3bbf8a;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1685" y="310" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_agent_orchestration_outbox" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;agent_orchestration_outbox&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;可靠发布子任务创建、结果回调、主 Agent 续跑和临时实例清理事件。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;子任务/回调/ACK 业务事务&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;Agent Outbox Publisher&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;PENDING → PUBLISHING → PUBLISHED；失败 RETRYING，耗尽 DEAD&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4f4ee;strokeColor=#3bbf8a;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="515" width="760" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="detail-08-2" name="02-agent_subagent_task + agent_parent_inbox">
    <mxGraphModel dx="2420" dy="2156" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="2156" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="多 Agent 编排、回调与清理：字段明细" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=30;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="44" y="20" width="2332" height="44" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="每页只展示 1–2 张表；先解释业务职责，再列完整字段、状态枚举、主键、唯一键和索引。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="46" y="68" width="2328" height="38" as="geometry" />
        </mxCell>
        <mxCell id="purpose_agent_subagent_task" value="&lt;div style='text-align:left;line-height:1.55'&gt;&lt;b style='font-size:20px'&gt;agent_subagent_task&lt;/b&gt;&lt;br&gt;&lt;b&gt;这张表解决什么：&lt;/b&gt;保存主 Agent 创建的每个子任务、Worker 租约、子会话、两级结果和回调状态。&lt;br&gt;&lt;b&gt;谁写入：&lt;/b&gt;SubagentOrchestrationService 与子 Agent Worker　　&lt;b&gt;谁读取：&lt;/b&gt;任务查询、结果回调、完整上下文读取和清理器&lt;br&gt;&lt;b&gt;关键生命周期：&lt;/b&gt;READY → RUNNING → SUCCEEDED/FAILED/CANCELLED → ACKED；回调独立推进至 DELIVERED&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4f4ee;strokeColor=#3bbf8a;fontSize=15;align=left;verticalAlign=middle;spacing=16;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="125" width="1120" height="150" as="geometry" />
        </mxCell>
        <mxCell id="table_agent_subagent_task" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;b style='font-size:21px'&gt;agent_subagent_task&lt;/b&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;临时子Agent任务与回调账本&lt;/span&gt;&lt;hr&gt;&lt;b&gt;字段&lt;/b&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[PK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　数据库自增主键（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;tenant_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租户业务标识，数据隔离边界（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;user_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　用户业务标识（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;parent_run_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[REF]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主 Agent 原始运行标识（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;parent_session_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主 Agent 会话标识（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;parent_agent_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主 Agent 业务标识（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;task_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　任务业务标识（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;child_agent_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　子 Agent 业务标识（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;child_session_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　临时子 Agent 会话标识（NOT NULL，默认 NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;instruction&lt;/b&gt; &lt;span style='color:#2563eb'&gt;MEDIUMTEXT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主 Agent 分发给子 Agent 的任务指令（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;function_call_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　模型工具调用唯一标识（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;trace_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　全链路追踪标识（NULL，默认 NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;status&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(24)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　业务状态；READY/RUNNING/SUCCEEDED/FAILED/CANCELLED/ACKED（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;attempt&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　任务已领取次数（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;fencing_token&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　单调递增栅栏令牌，阻止旧 Worker 回写（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;lease_owner&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　当前任务租约持有实例（NULL，默认 NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;lease_expires_at&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租约截止时间（NULL，默认 NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;result_text&lt;/b&gt; &lt;span style='color:#2563eb'&gt;MEDIUMTEXT DEFAULT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　子 Agent 总体输出（NULL，默认 NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;result_summary&lt;/b&gt; &lt;span style='color:#2563eb'&gt;TEXT DEFAULT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　自动注入主 Agent 的结果摘要（NOT NULL，默认 NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;full_context&lt;/b&gt; &lt;span style='color:#2563eb'&gt;MEDIUMTEXT DEFAULT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主 Agent 按需读取的完整上下文（NOT NULL，默认 NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;summary_truncated&lt;/b&gt; &lt;span style='color:#2563eb'&gt;TINYINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　摘要是否因长度限制被截断（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;error_code&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　稳定业务错误码（NULL，默认 NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;callback_status&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(24)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　子 Agent 结果回调状态；PENDING/DELIVERING/REGISTERED/DELIVERED/RETRYING/DEAD（NOT NULL，默认 &amp;#x27;PENDING&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;callback_owner&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　当前回调处理实例（NULL，默认 NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;callback_claimed_at&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　回调领取时间（NULL，默认 NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;callback_attempt&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　回调累计尝试次数（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;callback_last_error&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(1000)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　最近一次回调错误摘要（NULL，默认 NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;callback_delivered_at&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　结果完成业务回调时间（NULL，默认 NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;created_at&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　记录创建时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;completed_at&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　业务完成时间（NULL，默认 NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;acknowledged_at&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主 Agent 业务确认时间（NULL，默认 NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;updated_at&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　记录最后更新时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;deleted&lt;/b&gt; &lt;span style='color:#2563eb'&gt;TINYINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　逻辑删除标记：0 有效，1 已删除（NOT NULL，默认 0）&lt;/span&gt;&lt;hr&gt;&lt;b&gt;约束与索引&lt;/b&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;PK(id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_subagent_task_tenant_task(tenant_id, task_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_subagent_function_replay(tenant_id, parent_run_id, function_call_id, id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_subagent_parent_inbox(tenant_id, parent_run_id, status, id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_subagent_lease_recovery(status, lease_expires_at, id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_subagent_callback(callback_status, id)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3bbf8a;fontSize=14;align=left;verticalAlign=top;spacing=18;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="55" y="305" width="1120" height="1756" as="geometry" />
        </mxCell>
        <mxCell id="purpose_agent_parent_inbox" value="&lt;div style='text-align:left;line-height:1.55'&gt;&lt;b style='font-size:20px'&gt;agent_parent_inbox&lt;/b&gt;&lt;br&gt;&lt;b&gt;这张表解决什么：&lt;/b&gt;为主 Run 持久保存每个子任务的结果摘要和到达顺序，避免回调消息丢失。&lt;br&gt;&lt;b&gt;谁写入：&lt;/b&gt;Result Callback Consumer　　&lt;b&gt;谁读取：&lt;/b&gt;Parent Resume Worker&lt;br&gt;&lt;b&gt;关键生命周期：&lt;/b&gt;每个 parent_run + task 唯一；消费后写 consumed_at&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4f4ee;strokeColor=#3bbf8a;fontSize=15;align=left;verticalAlign=middle;spacing=16;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1245" y="125" width="1120" height="150" as="geometry" />
        </mxCell>
        <mxCell id="table_agent_parent_inbox" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;b style='font-size:21px'&gt;agent_parent_inbox&lt;/b&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;主Agent结果收件箱&lt;/span&gt;&lt;hr&gt;&lt;b&gt;字段&lt;/b&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[PK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　数据库自增主键（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;tenant_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租户业务标识，数据隔离边界（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;parent_run_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主 Agent 原始运行标识（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;task_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK] [REF]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　任务业务标识（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;child_agent_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　子 Agent 业务标识（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;result_summary&lt;/b&gt; &lt;span style='color:#2563eb'&gt;TEXT DEFAULT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　自动注入主 Agent 的结果摘要（NULL，默认 NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;task_status&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(24)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　子 Agent 任务完成时的状态快照（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;consumed_at&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　结果被主 Agent 消费的时间（NULL，默认 NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;created_at&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　记录创建时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;deleted&lt;/b&gt; &lt;span style='color:#2563eb'&gt;TINYINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　逻辑删除标记：0 有效，1 已删除（NOT NULL，默认 0）&lt;/span&gt;&lt;hr&gt;&lt;b&gt;约束与索引&lt;/b&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;PK(id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_parent_inbox_task(tenant_id, parent_run_id, task_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_parent_inbox_cursor(tenant_id, parent_run_id, id, consumed_at)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3bbf8a;fontSize=14;align=left;verticalAlign=top;spacing=18;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1245" y="305" width="1120" height="678" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="detail-08-3" name="03-agent_parent_resume_request + agent_orchestration_outbox">
    <mxGraphModel dx="2420" dy="1562" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="1562" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="多 Agent 编排、回调与清理：字段明细" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=30;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="44" y="20" width="2332" height="44" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="每页只展示 1–2 张表；先解释业务职责，再列完整字段、状态枚举、主键、唯一键和索引。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="46" y="68" width="2328" height="38" as="geometry" />
        </mxCell>
        <mxCell id="purpose_agent_parent_resume_request" value="&lt;div style='text-align:left;line-height:1.55'&gt;&lt;b style='font-size:20px'&gt;agent_parent_resume_request&lt;/b&gt;&lt;br&gt;&lt;b&gt;这张表解决什么：&lt;/b&gt;合并同一主 Run 的多个结果唤醒，并用 requested/processed version 保证续跑期间新结果不丢。&lt;br&gt;&lt;b&gt;谁写入：&lt;/b&gt;结果回调登记事务　　&lt;b&gt;谁读取：&lt;/b&gt;Parent Resume Consumer 与恢复扫描器&lt;br&gt;&lt;b&gt;关键生命周期：&lt;/b&gt;PENDING → RUNNING → COMPLETED；新结果到达重新 PENDING；失败 RETRYING/DEAD&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4f4ee;strokeColor=#3bbf8a;fontSize=15;align=left;verticalAlign=middle;spacing=16;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="125" width="1120" height="150" as="geometry" />
        </mxCell>
        <mxCell id="table_agent_parent_resume_request" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;b style='font-size:21px'&gt;agent_parent_resume_request&lt;/b&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;主Agent恢复请求与单飞租约&lt;/span&gt;&lt;hr&gt;&lt;b&gt;字段&lt;/b&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[PK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　数据库自增主键（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;tenant_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租户业务标识，数据隔离边界（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;user_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　用户业务标识（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;parent_run_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK] [REF]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主 Agent 原始运行标识（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;parent_session_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主 Agent 会话标识（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;parent_agent_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主 Agent 业务标识（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;trace_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　全链路追踪标识（NULL，默认 NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;status&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(24)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　业务状态；PENDING/RUNNING/RETRYING/COMPLETED/DEAD（NOT NULL，默认 &amp;#x27;PENDING&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;requested_version&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主 Agent 已请求续跑的最新版本（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;processed_version&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主 Agent 已处理完成的续跑版本（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;inbox_cursor&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主 Agent 已消费结果的最大游标（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;lease_owner&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　当前任务租约持有实例（NULL，默认 NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;fencing_token&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　单调递增栅栏令牌，阻止旧 Worker 回写（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;lease_expires_at&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租约截止时间（NULL，默认 NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;attempt_count&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　累计处理或发布尝试次数（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;next_attempt_at&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　下一次允许尝试时间（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;recovery_notified_at&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　恢复扫描已通知时间（NULL，默认 NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;last_error&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(1000)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　最近一次脱敏错误摘要（NULL，默认 NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;created_at&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　记录创建时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;updated_at&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　记录最后更新时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;deleted&lt;/b&gt; &lt;span style='color:#2563eb'&gt;TINYINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　逻辑删除标记：0 有效，1 已删除（NOT NULL，默认 0）&lt;/span&gt;&lt;hr&gt;&lt;b&gt;约束与索引&lt;/b&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;PK(id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_parent_resume_run(tenant_id, parent_run_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_parent_resume_due(status, next_attempt_at, lease_expires_at, id)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3bbf8a;fontSize=14;align=left;verticalAlign=top;spacing=18;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="55" y="305" width="1120" height="1162" as="geometry" />
        </mxCell>
        <mxCell id="purpose_agent_orchestration_outbox" value="&lt;div style='text-align:left;line-height:1.55'&gt;&lt;b style='font-size:20px'&gt;agent_orchestration_outbox&lt;/b&gt;&lt;br&gt;&lt;b&gt;这张表解决什么：&lt;/b&gt;可靠发布子任务创建、结果回调、主 Agent 续跑和临时实例清理事件。&lt;br&gt;&lt;b&gt;谁写入：&lt;/b&gt;子任务/回调/ACK 业务事务　　&lt;b&gt;谁读取：&lt;/b&gt;Agent Outbox Publisher&lt;br&gt;&lt;b&gt;关键生命周期：&lt;/b&gt;PENDING → PUBLISHING → PUBLISHED；失败 RETRYING，耗尽 DEAD&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4f4ee;strokeColor=#3bbf8a;fontSize=15;align=left;verticalAlign=middle;spacing=16;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1245" y="125" width="1120" height="150" as="geometry" />
        </mxCell>
        <mxCell id="table_agent_orchestration_outbox" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;b style='font-size:21px'&gt;agent_orchestration_outbox&lt;/b&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;Agent编排Transactional Outbox&lt;/span&gt;&lt;hr&gt;&lt;b&gt;字段&lt;/b&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[PK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　数据库自增主键（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;tenant_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租户业务标识，数据隔离边界（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;event_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　事件业务标识（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;event_type&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　事件类型与协议版本（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;aggregate_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[REF]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　事件所属聚合业务标识（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;partition_key&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　Kafka 分区键（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;payload&lt;/b&gt; &lt;span style='color:#2563eb'&gt;JSON NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　事件载荷 JSON（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;status&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(24)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　业务状态；PENDING/PUBLISHING/PUBLISHED/RETRYING/DEAD（NOT NULL，默认 &amp;#x27;PENDING&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;attempt_count&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　累计处理或发布尝试次数（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;max_attempts&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　自动处理最大尝试次数（NOT NULL，默认 12）&lt;/span&gt;&lt;br&gt;&lt;b&gt;next_attempt_at&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　下一次允许尝试时间（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;lease_owner&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　当前任务租约持有实例（NULL，默认 NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;fencing_token&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　单调递增栅栏令牌，阻止旧 Worker 回写（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;lease_expires_at&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租约截止时间（NULL，默认 NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;last_error&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(1000)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　最近一次脱敏错误摘要（NULL，默认 NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;published_at&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　消息发布确认时间（NULL，默认 NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;created_at&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　记录创建时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;updated_at&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　记录最后更新时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;deleted&lt;/b&gt; &lt;span style='color:#2563eb'&gt;TINYINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　逻辑删除标记：0 有效，1 已删除（NOT NULL，默认 0）&lt;/span&gt;&lt;hr&gt;&lt;b&gt;约束与索引&lt;/b&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;PK(id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_agent_outbox_event(tenant_id, event_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_agent_outbox_due(status, next_attempt_at, id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_agent_outbox_lease(status, lease_expires_at, id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_agent_outbox_aggregate(tenant_id, aggregate_id, id)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3bbf8a;fontSize=14;align=left;verticalAlign=top;spacing=18;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1245" y="305" width="1120" height="1118" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>