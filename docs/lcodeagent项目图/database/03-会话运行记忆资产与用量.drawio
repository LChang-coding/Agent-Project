<?xml version='1.0' encoding='UTF-8'?>
<mxfile host="Electron" modified="2026-08-14T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="overview-03" name="01-领域总览与表职责">
    <mxGraphModel dx="2500" dy="970" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="970" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="会话、运行、记忆、资产与用量：表职责与业务链路" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=30;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="44" y="20" width="2412" height="44" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="保存一次对话从会话创建、单轮运行、消息输出到记忆压缩、资产引用和用量审计的完整事实。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="46" y="68" width="2408" height="38" as="geometry" />
        </mxCell>
        <mxCell id="flows" value="&lt;div style='text-align:left;line-height:1.65'&gt;&lt;b style='font-size:18px'&gt;核心业务链路&lt;/b&gt;&lt;br&gt;运行主链：chat_session → chat_run → chat_message&lt;br&gt;上下文链：chat_message → context_compaction_task → conversation_memory_snapshot → 下一轮 chat_run&lt;br&gt;资产与用量：chat_message → artifact_asset；chat_run → model_usage&lt;br&gt;分享链：chat_session → chat_session_share → chat_session_import → 新 chat_session&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9fafb;strokeColor=#6b7280;fontSize=15;align=left;verticalAlign=middle;spacing=14;dashed=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="120" width="2390" height="160" as="geometry" />
        </mxCell>
        <mxCell id="purpose_chat_session" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;chat_session&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;保存长生命周期会话及其 Agent/工作流目标、RAG 策略和上下文版本。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;会话创建与配置服务&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;ChatService、历史列表和上下文装配器&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;active → archived/deleted；配置变更只影响后续 Run&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="310" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_chat_message" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;chat_message&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;按 sequence_no 保存用户、模型、工具和系统消息，并标记所属 Run 与上下文有效性。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;ChatService 和工具结果写入器&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;历史接口、上下文装配和记忆压缩&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;active；引导/重跑后可 invalidated 或 superseded&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="870" y="310" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_chat_run" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;chat_run&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;保存每一轮 Agent/工作流运行的权威状态、取消标记、RAG 快照和上下文 revision。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;ChatService/工作流启动服务&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;工具闸门、工作流运行时、取消与恢复 Worker&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;CREATED → RUNNING → COMPLETED/FAILED/CANCELLED/SUPERSEDED&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1685" y="310" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_artifact_asset" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;artifact_asset&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;登记上传附件和模型生成资产的对象位置、哈希、解析文本与可见范围。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;资产上传与解析服务&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;会话附件展示、上下文装配和 RAG 入库&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;active；解析 ready/failed/unsupported；删除时软删除&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="515" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_model_usage" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;model_usage&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;记录每次模型调用的模型版本、Token、终态和 Trace，用于成本与性能分析。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;模型调用用量记录器&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;统计接口、监控和成本核算&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;每次 call_id 幂等写入 success/failed/cancelled&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="870" y="515" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_conversation_memory_snapshot" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;conversation_memory_snapshot&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;保存覆盖早期消息的结构化长期摘要，避免每轮加载完整历史。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;上下文压缩 Worker&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;下一轮 Context Manager&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;新版本 active；旧版本 superseded/stale&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1685" y="515" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_context_compaction_task" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;context_compaction_task&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;记录待压缩的消息区间、基准 revision、重试次数和 Worker 租约。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;上下文阈值判断与单轮结束钩子&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;压缩 Worker 和恢复扫描器&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;PENDING → PROCESSING → SUCCEEDED；失败 RETRYING/DEAD/STALE&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="720" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_chat_session_share" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;chat_session_share&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;保存会话导出物、分享令牌哈希、有效期和最大读取次数。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;会话分享服务&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;匿名/授权分享读取接口&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;active → revoked/expired；下载次数达到上限后不可用&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="870" y="720" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_chat_session_import" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;chat_session_import&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;记录接收者从分享包复制出的新会话，防止同一接收者重复导入。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;会话导入服务&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;导入幂等检查和审计&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;completed/failed；share_id + recipient_scope_key 唯一&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1685" y="720" width="760" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="detail-03-2" name="02-chat_session + chat_message">
    <mxGraphModel dx="2420" dy="1782" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="1782" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="会话、运行、记忆、资产与用量：字段明细" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=30;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="44" y="20" width="2332" height="44" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="每页只展示 1–2 张表；先解释业务职责，再列完整字段、状态枚举、主键、唯一键和索引。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="46" y="68" width="2328" height="38" as="geometry" />
        </mxCell>
        <mxCell id="purpose_chat_session" value="&lt;div style='text-align:left;line-height:1.55'&gt;&lt;b style='font-size:20px'&gt;chat_session&lt;/b&gt;&lt;br&gt;&lt;b&gt;这张表解决什么：&lt;/b&gt;保存长生命周期会话及其 Agent/工作流目标、RAG 策略和上下文版本。&lt;br&gt;&lt;b&gt;谁写入：&lt;/b&gt;会话创建与配置服务　　&lt;b&gt;谁读取：&lt;/b&gt;ChatService、历史列表和上下文装配器&lt;br&gt;&lt;b&gt;关键生命周期：&lt;/b&gt;active → archived/deleted；配置变更只影响后续 Run&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=left;verticalAlign=middle;spacing=16;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="125" width="1120" height="150" as="geometry" />
        </mxCell>
        <mxCell id="table_chat_session" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;b style='font-size:21px'&gt;chat_session&lt;/b&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;chat_session&lt;/span&gt;&lt;hr&gt;&lt;b&gt;字段&lt;/b&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[PK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主键（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;tenant_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租户业务ID，个体户可为空（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;user_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　会话归属用户ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;session_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　会话业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;agent_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　Agent ID（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;agent_name&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　Agent 名称（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;source_type&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　数据或运行来源类型；agent=普通 Agent；workflow=工作流（NOT NULL，默认 &amp;#x27;&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;workflow_version&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　运行冻结的工作流版本（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;model_code&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　运行冻结的模型编码（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;task_type&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　任务类型（NOT NULL，默认 &amp;#x27;agent_prompt&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;task_payload&lt;/b&gt; &lt;span style='color:#2563eb'&gt;LONGTEXT NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　白名单任务载荷 JSON（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;run_as_role_code&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　固化执行角色（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;app_name&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　应用名称（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;title&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(255)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　会话标题（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;status&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　会话状态：active/archived/deleted；active=活跃；archived=归档；deleted=删除（NOT NULL，默认 &amp;#x27;active&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;rag_enabled&lt;/b&gt; &lt;span style='color:#2563eb'&gt;TINYINT(1)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　是否启用 RAG（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;rag_mode&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(16)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　RAG 绑定选择模式；OFF=关闭；AUTO=自动绑定；MANUAL=手动绑定（NOT NULL，默认 &amp;#x27;&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;rag_revision&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　会话 RAG 策略乐观锁版本（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;last_message_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　最后消息时间（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;metadata&lt;/b&gt; &lt;span style='color:#2563eb'&gt;JSON NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　扩展信息（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;create_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　创建时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;update_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　更新时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;deleted&lt;/b&gt; &lt;span style='color:#2563eb'&gt;TINYINT(1)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　删除标记，0未删除，1已删除（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;context_revision&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　有效上下文版本（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;rag_invocation_mode&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　RAG调用方式：AUTO_CONTEXT/AGENT_TOOL；AUTO_CONTEXT=自动注入；AGENT_TOOL=Agent 按需调用（NOT NULL，默认 &amp;#x27;AUTO_CONTEXT&amp;#x27;）&lt;/span&gt;&lt;hr&gt;&lt;b&gt;约束与索引&lt;/b&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;PK(id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_chat_session_id(session_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_chat_session_user(user_id, last_message_time)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_chat_session_tenant(tenant_id, last_message_time)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_chat_session_agent(agent_name)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=14;align=left;verticalAlign=top;spacing=18;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="55" y="305" width="1120" height="1382" as="geometry" />
        </mxCell>
        <mxCell id="purpose_chat_message" value="&lt;div style='text-align:left;line-height:1.55'&gt;&lt;b style='font-size:20px'&gt;chat_message&lt;/b&gt;&lt;br&gt;&lt;b&gt;这张表解决什么：&lt;/b&gt;按 sequence_no 保存用户、模型、工具和系统消息，并标记所属 Run 与上下文有效性。&lt;br&gt;&lt;b&gt;谁写入：&lt;/b&gt;ChatService 和工具结果写入器　　&lt;b&gt;谁读取：&lt;/b&gt;历史接口、上下文装配和记忆压缩&lt;br&gt;&lt;b&gt;关键生命周期：&lt;/b&gt;active；引导/重跑后可 invalidated 或 superseded&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=left;verticalAlign=middle;spacing=16;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1245" y="125" width="1120" height="150" as="geometry" />
        </mxCell>
        <mxCell id="table_chat_message" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;b style='font-size:21px'&gt;chat_message&lt;/b&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;chat_message&lt;/span&gt;&lt;hr&gt;&lt;b&gt;字段&lt;/b&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[PK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主键（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;tenant_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租户业务ID，个体户可为空（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;user_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　消息归属用户ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;session_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK] [REF]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　会话业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;message_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　消息业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;role&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　消息角色：user/assistant/tool/system；user=用户；assistant=模型；tool=工具；system=系统（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;content_type&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　内容类型：text/json/markdown/file_ref（NOT NULL，默认 &amp;#x27;text&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;content&lt;/b&gt; &lt;span style='color:#2563eb'&gt;LONGTEXT NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　消息内容（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;sequence_no&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　会话内消息序号（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;parent_message_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　父消息ID（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;trace_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　链路ID（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;metadata&lt;/b&gt; &lt;span style='color:#2563eb'&gt;JSON NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　扩展信息（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;create_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　创建时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;update_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　更新时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;deleted&lt;/b&gt; &lt;span style='color:#2563eb'&gt;TINYINT(1)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　删除标记，0未删除，1已删除（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;estimated_token_count&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　上下文 token 预估值（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;run_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[REF]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　所属运行ID（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;validity_status&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　有效性：active/invalidated/superseded；active=有效；invalidated=已失效；superseded=被替代（NOT NULL，默认 &amp;#x27;active&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;invalid_reason&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(256)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　失效原因（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;invalidated_at&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　失效时间（NULL）&lt;/span&gt;&lt;hr&gt;&lt;b&gt;约束与索引&lt;/b&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;PK(id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_chat_message_id(message_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_chat_message_seq(session_id, sequence_no)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_chat_message_session(session_id, id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_chat_message_user(user_id, id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_chat_message_trace(trace_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_chat_message_run(tenant_id, user_id, session_id, run_id, validity_status)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_chat_message_context(tenant_id, user_id, session_id, validity_status, sequence_no)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=14;align=left;verticalAlign=top;spacing=18;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1245" y="305" width="1120" height="1228" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
