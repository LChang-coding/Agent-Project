<?xml version='1.0' encoding='UTF-8'?>
<mxfile host="Electron" modified="2026-08-14T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="overview-04" name="01-领域总览与表职责">
    <mxGraphModel dx="2500" dy="1585" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1585" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="RAG 知识库、摄取、检索与评测：表职责与业务链路" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=30;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="44" y="20" width="2412" height="44" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="保存知识库文档版本、切片索引、可靠摄取、在线检索引用以及离线评测的全过程。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="46" y="68" width="2408" height="38" as="geometry" />
        </mxCell>
        <mxCell id="flows" value="&lt;div style='text-align:left;line-height:1.65'&gt;&lt;b style='font-size:18px'&gt;核心业务链路&lt;/b&gt;&lt;br&gt;数据链：rag_knowledge_base → rag_document → rag_document_version → rag_chunk&lt;br&gt;摄取链：rag_ingest_task ↔ rag_outbox → Kafka/Worker → version ready + chunk active&lt;br&gt;检索链：rag_retrieval_profile → rag_agent_binding → rag_retrieval_record → rag_retrieval_citation&lt;br&gt;删除链：rag_knowledge_base_delete_task → 子文档删除任务 → 知识库删除终态&lt;br&gt;评测链：rag_benchmark_dataset → rag_benchmark_run → 明细/聚合/失败样本&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9fafb;strokeColor=#6b7280;fontSize=15;align=left;verticalAlign=middle;spacing=14;dashed=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="120" width="2390" height="160" as="geometry" />
        </mxCell>
        <mxCell id="purpose_rag_knowledge_base" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;rag_knowledge_base&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;知识库根实体，保存向量集合别名、Embedding 维度和当前可见 generation。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;知识库管理服务&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;摄取、检索、绑定和删除服务&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;active/indexing/disabled → deleting/deleted&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="310" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_rag_document" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;rag_document&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;保存逻辑文档及当前可见版本/generation，指向原始文件和最近索引结果。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;文档上传与摄取协调器&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;文档管理、检索范围过滤和删除服务&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;created/indexing → indexed；失败 failed；删除 deleting/deleted&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="870" y="310" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_rag_document_version" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;rag_document_version&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;保存文档每次上传或重建的不可变版本、解析产物和索引统计。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;上传登记事务与摄取 Worker&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;Chunk 查询、引用审计和历史版本管理&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;created → queued → processing → ready；失败/cancelled/superseded/deleted&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1685" y="310" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_rag_chunk" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;rag_chunk&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;保存可检索的父子切片、标题路径、页码、相邻关系和 Qdrant Point 标识。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;RAG 解析切块 Worker&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;Dense/Sparse 检索、邻块扩展和引用生成&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;随 generation 写入 active；版本删除后 deleted&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="515" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_rag_ingest_task" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;rag_ingest_task&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;RAG 摄取、重建和删除的权威任务账本，保存 Lease、心跳、checkpoint 和重试。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;上传/重建/删除登记事务&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;Kafka 消费 Worker 与数据库恢复扫描器&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;pending → running → completed；retrying/cancel_requested/cancelled/failed/dead&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="870" y="515" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_rag_outbox" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;rag_outbox&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;把 RAG 任务事件与业务事务一起落库，避免数据库成功但 Kafka 消息丢失。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;RAG 任务登记事务&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;Outbox Publisher&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;pending → publishing → published；失败 retrying，耗尽 dead&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1685" y="515" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_rag_retrieval_profile" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;rag_retrieval_profile&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;保存 Dense、Sparse、融合、Rerank、TopK、阈值和 Token 预算等检索策略。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;RAG 策略管理服务&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;RagRetrievalService&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;active/disabled；revision 保障配置并发更新&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="720" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_rag_agent_binding" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;rag_agent_binding&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;把 Agent、工作流或节点绑定到知识库和检索策略，并设置优先级与失败策略。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;RAG 绑定管理服务&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;会话 RAG 解析器和检索服务&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;active/disabled；target + kb 唯一&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="870" y="720" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_chat_session_rag_binding_selection" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;chat_session_rag_binding_selection&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;保存 MANUAL 模式下用户为当前会话选择的具体 RAG 绑定。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;会话 RAG 配置接口&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;Run 创建时的 RAG 快照器&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;随会话配置增删；session_id + binding_id 唯一&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1685" y="720" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_rag_retrieval_record" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;rag_retrieval_record&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;记录一次真实检索的请求快照、候选数量、各阶段耗时、终态和错误。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;RagRetrievalService 审计组件&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;检索调试、监控和评测分析&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;success/empty/failed/cancelled；retrieval_id 唯一&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="925" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_rag_retrieval_citation" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;rag_retrieval_citation&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;保存一次检索最终返回给 Agent 的证据切片、排名、分数、页码和内容哈希。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;检索结果组装与证据服务&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;答案引用校验、前端引用展示和审计&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;按 retrieval_id + rank_no 写入；内容快照可按策略清理&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="870" y="925" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_rag_knowledge_base_delete_task" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;rag_knowledge_base_delete_task&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;协调知识库下多个文档的向量、Chunk 和原件删除，并记录父任务进度。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;知识库删除服务&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;删除 Dispatcher 和恢复扫描器&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;PENDING/RUNNING/WAITING/RETRYING → COMPLETED；FAILED/DEAD&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1685" y="925" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_rag_benchmark_dataset" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;rag_benchmark_dataset&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;冻结公开评测数据集版本、来源、许可证和内容摘要。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;评测数据准备工具&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;RAG Benchmark Runner&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;manifest_sha256 唯一；数据集版本只追加不覆盖&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="1130" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_rag_benchmark_run" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;rag_benchmark_run&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;记录一次固定代码、配置、格式和数据集上的完整 RAG 评测运行。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;Benchmark Runner&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;评测报表和结果对比工具&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;running → completed/failed/cancelled；持续累计完成数和错误数&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="870" y="1130" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_rag_benchmark_document_result" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;rag_benchmark_document_result&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;保存每个 PDF/DOCX 文档的解析、质量、切块和入库结果。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;Benchmark 文档执行器&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;质量分析与失败定位工具&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;completed/failed/degraded/cancelled；每个 run + format_document 唯一&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1685" y="1130" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_rag_benchmark_query_result" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;rag_benchmark_query_result&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;保存每个查询在各检索策略下的排名、Recall、MRR、nDCG、MAP 和耗时。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;Benchmark 检索执行器&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;指标聚合与策略比较工具&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;每个 run + variant + query 唯一；保留原始明细&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="1335" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_rag_benchmark_aggregate" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;rag_benchmark_aggregate&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;保存按全量、格式或复杂度切片聚合后的质量、延迟和候选规模指标。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;Benchmark 聚合器&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;最终评测报告&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;由 query_result 汇总生成；metrics_sha256 用于结果校验&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="870" y="1335" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_rag_benchmark_failure_case" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;rag_benchmark_failure_case&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;保存召回失败的首个失败阶段、事实、因果分析和证据文件引用。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;Benchmark 失败分析器&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;调试与策略优化人员&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;failure_id 唯一；与 run 和可选 query/document 关联&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1685" y="1335" width="760" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="detail-04-2" name="02-rag_knowledge_base + rag_document">
    <mxGraphModel dx="2420" dy="2156" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="2156" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="RAG 知识库、摄取、检索与评测：字段明细" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=30;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="44" y="20" width="2332" height="44" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="每页只展示 1–2 张表；先解释业务职责，再列完整字段、状态枚举、主键、唯一键和索引。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="46" y="68" width="2328" height="38" as="geometry" />
        </mxCell>
        <mxCell id="purpose_rag_knowledge_base" value="&lt;div style='text-align:left;line-height:1.55'&gt;&lt;b style='font-size:20px'&gt;rag_knowledge_base&lt;/b&gt;&lt;br&gt;&lt;b&gt;这张表解决什么：&lt;/b&gt;知识库根实体，保存向量集合别名、Embedding 维度和当前可见 generation。&lt;br&gt;&lt;b&gt;谁写入：&lt;/b&gt;知识库管理服务　　&lt;b&gt;谁读取：&lt;/b&gt;摄取、检索、绑定和删除服务&lt;br&gt;&lt;b&gt;关键生命周期：&lt;/b&gt;active/indexing/disabled → deleting/deleted&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=left;verticalAlign=middle;spacing=16;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="125" width="1120" height="150" as="geometry" />
        </mxCell>
        <mxCell id="table_rag_knowledge_base" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;b style='font-size:21px'&gt;rag_knowledge_base&lt;/b&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;rag_knowledge_base&lt;/span&gt;&lt;hr&gt;&lt;b&gt;字段&lt;/b&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[PK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主键（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;tenant_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租户业务ID，个体户可为空（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;owner_user_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　知识库拥有者用户ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;visibility&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　可见范围：private/tenant_public（NOT NULL，默认 &amp;#x27;private&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;kb_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　知识库业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;kb_name&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　知识库名称（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;description&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(512)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　知识库描述（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;embedding_model&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　Embedding 模型（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;status&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　知识库状态：active/disabled/indexing；active=可用；disabled=停用；indexing=构建中；deleting/deleted=删除中/已删除（NOT NULL，默认 &amp;#x27;active&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;metadata&lt;/b&gt; &lt;span style='color:#2563eb'&gt;JSON NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　扩展信息（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;create_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　创建时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;update_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　更新时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;deleted&lt;/b&gt; &lt;span style='color:#2563eb'&gt;TINYINT(1)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　删除标记，0未删除，1已删除（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;embedding_dimension&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　向量维度（NOT NULL，默认 768）&lt;/span&gt;&lt;br&gt;&lt;b&gt;collection_alias&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　Qdrant 稳定集合别名（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;current_generation&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　当前可见索代引代（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;retrieval_profile_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　默认检索策略ID（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;revision&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　配置乐观锁版本（NOT NULL，默认 1）&lt;/span&gt;&lt;hr&gt;&lt;b&gt;约束与索引&lt;/b&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;PK(id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_rag_kb_id(kb_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_rag_kb_tenant_id(tenant_id, kb_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_rag_kb_tenant_name(tenant_id, kb_name)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_rag_kb_owner(owner_user_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_rag_kb_tenant_visibility(tenant_id, visibility, status)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_rag_kb_tenant_status_update(tenant_id, status, update_time)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=18;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="55" y="305" width="1120" height="1118" as="geometry" />
        </mxCell>
        <mxCell id="purpose_rag_document" value="&lt;div style='text-align:left;line-height:1.55'&gt;&lt;b style='font-size:20px'&gt;rag_document&lt;/b&gt;&lt;br&gt;&lt;b&gt;这张表解决什么：&lt;/b&gt;保存逻辑文档及当前可见版本/generation，指向原始文件和最近索引结果。&lt;br&gt;&lt;b&gt;谁写入：&lt;/b&gt;文档上传与摄取协调器　　&lt;b&gt;谁读取：&lt;/b&gt;文档管理、检索范围过滤和删除服务&lt;br&gt;&lt;b&gt;关键生命周期：&lt;/b&gt;created/indexing → indexed；失败 failed；删除 deleting/deleted&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=left;verticalAlign=middle;spacing=16;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1245" y="125" width="1120" height="150" as="geometry" />
        </mxCell>
        <mxCell id="table_rag_document" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;b style='font-size:21px'&gt;rag_document&lt;/b&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;rag_document&lt;/span&gt;&lt;hr&gt;&lt;b&gt;字段&lt;/b&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[PK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主键（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;tenant_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租户业务ID，个体户可为空（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;owner_user_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　文档上传者用户ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;visibility&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　可见范围：private/tenant_public（NOT NULL，默认 &amp;#x27;private&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;kb_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[REF]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　知识库业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;document_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　文档业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;file_name&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(255)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　文件名（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;source_type&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　来源类型：upload/url/text/oss（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;source_uri&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(512)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　来源地址（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;content_hash&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　内容哈希（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;status&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　文档状态：active/indexing/indexed/failed/deleted；created/indexing/indexed/failed/deleting/deleted（NOT NULL，默认 &amp;#x27;active&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;metadata&lt;/b&gt; &lt;span style='color:#2563eb'&gt;JSON NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　扩展信息（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;create_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　创建时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;update_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　更新时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;deleted&lt;/b&gt; &lt;span style='color:#2563eb'&gt;TINYINT(1)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　删除标记，0未删除，1已删除（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;asset_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　关联原始资产业务ID（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;source_bucket&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　原始文件存储桶（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;source_object_key&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(512)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　原始文件对象Key（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;mime_type&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　原始文件MIME（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;size_bytes&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　原始文件字节数（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;document_version&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　当前文档版本号（NOT NULL，默认 1）&lt;/span&gt;&lt;br&gt;&lt;b&gt;active_generation&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　当前对检索可见的索代引代（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;active_version_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　当前对检索可见的文档版本ID（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;target_generation&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　正在构建的目标索代引代（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;parser_name&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　解析器名称（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;parser_version&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　解析器版本（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;page_count&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　解析页数（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;chunk_count&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　当前可见切片数（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;last_error_code&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　最近错误码（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;last_error_message&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(1000)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　脱敏后的最近错误摘要（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;indexed_at&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　最近成功入索引时间UTC（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;revision&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　状态乐观锁版本（NOT NULL，默认 1）&lt;/span&gt;&lt;hr&gt;&lt;b&gt;约束与索引&lt;/b&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;PK(id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_rag_document_id(document_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_rag_document_tenant_id(tenant_id, document_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_rag_document_kb(kb_id, create_time)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_rag_document_owner(owner_user_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_rag_document_tenant_visibility(tenant_id, visibility, status)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_rag_document_tenant_kb_status(tenant_id, kb_id, status, id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_rag_document_tenant_hash(tenant_id, kb_id, content_hash)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=18;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1245" y="305" width="1120" height="1756" as="geometry" />
        </mxCell>
      </root>
