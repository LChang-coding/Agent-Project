    <mxGraphModel dx="2420" dy="2112" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="2112" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="RAG 知识库、摄取、检索与评测：字段明细" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=30;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="44" y="20" width="2332" height="44" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="每页只展示 1–2 张表；先解释业务职责，再列完整字段、状态枚举、主键、唯一键和索引。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="46" y="68" width="2328" height="38" as="geometry" />
        </mxCell>
        <mxCell id="purpose_rag_document_version" value="&lt;div style='text-align:left;line-height:1.55'&gt;&lt;b style='font-size:20px'&gt;rag_document_version&lt;/b&gt;&lt;br&gt;&lt;b&gt;这张表解决什么：&lt;/b&gt;保存文档每次上传或重建的不可变版本、解析产物和索引统计。&lt;br&gt;&lt;b&gt;谁写入：&lt;/b&gt;上传登记事务与摄取 Worker　　&lt;b&gt;谁读取：&lt;/b&gt;Chunk 查询、引用审计和历史版本管理&lt;br&gt;&lt;b&gt;关键生命周期：&lt;/b&gt;created → queued → processing → ready；失败/cancelled/superseded/deleted&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=left;verticalAlign=middle;spacing=16;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="125" width="1120" height="150" as="geometry" />
        </mxCell>
        <mxCell id="table_rag_document_version" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;b style='font-size:21px'&gt;rag_document_version&lt;/b&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;RAG文档不可变版本&lt;/span&gt;&lt;hr&gt;&lt;b&gt;字段&lt;/b&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[PK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主键（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;tenant_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租户业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;kb_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　知识库业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;document_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK] [REF]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　文档业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;version_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　文档版本业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;version_no&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　单文档递增版本号（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;generation&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　本版本目标索代引代（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;asset_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　关联原始资产业务ID（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;source_bucket&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　原始文件存储桶（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;source_object_key&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(512)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　原始文件对象Key（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;file_name&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(255)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　安全文件名（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;mime_type&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　文件MIME（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;size_bytes&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　文件字节数（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;content_hash&lt;/b&gt; &lt;span style='color:#2563eb'&gt;CHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　原始文件SHA-256（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;parser_name&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　解析器名称（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;parser_version&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　解析器版本（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;chunker_version&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　分块器版本（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;embedding_model_revision&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　Embedding模型固定版本（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;parsed_bucket&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　解析产物存储桶（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;parsed_object_key&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(512)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　结构化解析产物对象Key（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;page_count&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　页数（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;character_count&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　规范化字符数（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;chunk_count&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　切片数（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;status&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　created/queued/processing/ready/failed/cancelled/superseded/deleting/deleted（NOT NULL，默认 &amp;#x27;created&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;metadata&lt;/b&gt; &lt;span style='color:#2563eb'&gt;JSON NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　不承载状态机的扩展元数据（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;row_version&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　状态乐观锁版本（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;indexed_at&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　成功入索引时间UTC（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;create_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　创建时间UTC（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;update_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　更新时间UTC（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;deleted&lt;/b&gt; &lt;span style='color:#2563eb'&gt;TINYINT(1)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　逻辑删除标记（NOT NULL，默认 0）&lt;/span&gt;&lt;hr&gt;&lt;b&gt;约束与索引&lt;/b&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;PK(id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_rag_doc_version_id(tenant_id, version_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_rag_doc_version_no(tenant_id, document_id, version_no)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_rag_doc_generation(tenant_id, document_id, generation)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_rag_doc_version_kb(tenant_id, kb_id, status, id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_rag_doc_version_hash(tenant_id, kb_id, content_hash)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=18;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="55" y="305" width="1120" height="1624" as="geometry" />
        </mxCell>
        <mxCell id="purpose_rag_chunk" value="&lt;div style='text-align:left;line-height:1.55'&gt;&lt;b style='font-size:20px'&gt;rag_chunk&lt;/b&gt;&lt;br&gt;&lt;b&gt;这张表解决什么：&lt;/b&gt;保存可检索的父子切片、标题路径、页码、相邻关系和 Qdrant Point 标识。&lt;br&gt;&lt;b&gt;谁写入：&lt;/b&gt;RAG 解析切块 Worker　　&lt;b&gt;谁读取：&lt;/b&gt;Dense/Sparse 检索、邻块扩展和引用生成&lt;br&gt;&lt;b&gt;关键生命周期：&lt;/b&gt;随 generation 写入 active；版本删除后 deleted&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=left;verticalAlign=middle;spacing=16;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1245" y="125" width="1120" height="150" as="geometry" />
        </mxCell>
        <mxCell id="table_rag_chunk" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;b style='font-size:21px'&gt;rag_chunk&lt;/b&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;rag_chunk&lt;/span&gt;&lt;hr&gt;&lt;b&gt;字段&lt;/b&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[PK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主键（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;tenant_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租户业务ID，个体户可为空（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;owner_user_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　切片归属用户ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;visibility&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　可见范围：private/tenant_public（NOT NULL，默认 &amp;#x27;private&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;kb_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　知识库业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;document_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　文档业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;chunk_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　切片业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;chunk_index&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　文档内切片序号（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;content&lt;/b&gt; &lt;span style='color:#2563eb'&gt;LONGTEXT NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　切片内容（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;token_count&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　切片 token 数（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;embedding_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　向量库中的向量ID（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;status&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　切片状态：active/deleted；active=可检索；deleted=不可检索（NOT NULL，默认 &amp;#x27;active&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;metadata&lt;/b&gt; &lt;span style='color:#2563eb'&gt;JSON NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　扩展信息（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;create_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　创建时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;update_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　更新时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;deleted&lt;/b&gt; &lt;span style='color:#2563eb'&gt;TINYINT(1)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　删除标记，0未删除，1已删除（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;document_version&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　所属文档版本（NOT NULL，默认 1）&lt;/span&gt;&lt;br&gt;&lt;b&gt;version_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[REF]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　所属文档版本业务ID（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;generation&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　索引构建代引代（NOT NULL，默认 1）&lt;/span&gt;&lt;br&gt;&lt;b&gt;parent_chunk_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　父级切片ID（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;previous_chunk_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　前一切片ID（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;next_chunk_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　后一切片ID（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;section_path&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(1000)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　标题层级路径（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;page_from&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　起始页码，从1开始（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;page_to&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　结束页码，从1开始（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;char_start&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　规范化文档内起始字符偏移（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;char_end&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　规范化文档内结束字符偏移（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;content_hash&lt;/b&gt; &lt;span style='color:#2563eb'&gt;CHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　切片正文SHA-256（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;vector_point_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　Qdrant确定性Point ID（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;revision&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　切片乐观锁版本（NOT NULL，默认 1）&lt;/span&gt;&lt;hr&gt;&lt;b&gt;约束与索引&lt;/b&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;PK(id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_rag_chunk_id(chunk_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_rag_chunk_doc_idx(document_id, chunk_index)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_rag_chunk_tenant_id(tenant_id, chunk_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_rag_chunk_doc_generation_idx(tenant_id, document_id, generation, chunk_index)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_rag_chunk_doc(document_id, chunk_index)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_rag_chunk_kb(kb_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_rag_chunk_tenant_visibility(tenant_id, visibility, status)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_rag_chunk_retrieval_scope(tenant_id, kb_id, generation, status, id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_rag_chunk_document_version(tenant_id, document_id, document_version, generation, chunk_index)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=18;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1245" y="305" width="1120" height="1712" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
