      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="RAG 知识库、摄取、检索与评测：字段明细" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=30;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="44" y="20" width="2332" height="44" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="每页只展示 1–2 张表；先解释业务职责，再列完整字段、状态枚举、主键、唯一键和索引。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="46" y="68" width="2328" height="38" as="geometry" />
        </mxCell>
        <mxCell id="purpose_rag_retrieval_citation" value="&lt;div style='text-align:left;line-height:1.55'&gt;&lt;b style='font-size:20px'&gt;rag_retrieval_citation&lt;/b&gt;&lt;br&gt;&lt;b&gt;这张表解决什么：&lt;/b&gt;保存一次检索最终返回给 Agent 的证据切片、排名、分数、页码和内容哈希。&lt;br&gt;&lt;b&gt;谁写入：&lt;/b&gt;检索结果组装与证据服务　　&lt;b&gt;谁读取：&lt;/b&gt;答案引用校验、前端引用展示和审计&lt;br&gt;&lt;b&gt;关键生命周期：&lt;/b&gt;按 retrieval_id + rank_no 写入；内容快照可按策略清理&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=left;verticalAlign=middle;spacing=16;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="125" width="1120" height="150" as="geometry" />
        </mxCell>
        <mxCell id="table_rag_retrieval_citation" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;b style='font-size:21px'&gt;rag_retrieval_citation&lt;/b&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;RAG最终引用及各阶段分数&lt;/span&gt;&lt;hr&gt;&lt;b&gt;字段&lt;/b&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[PK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主键（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;tenant_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租户业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;retrieval_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK] [REF]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　检索调用业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;citation_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　引用业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;rank_no&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　最终引用排序，从1开始（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;kb_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　知识库业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;document_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　文档业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;document_version&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　文档版本号（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;generation&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　索代引代（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;chunk_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[REF]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　切片业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;vector_point_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　Qdrant Point ID（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;dense_score&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DECIMAL(20,12)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　Dense原始分数（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;sparse_score&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DECIMAL(20,12)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　Sparse原始分数（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;fusion_score&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DECIMAL(20,12)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　融合分数（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;rerank_score&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DECIMAL(20,12)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　重排分数（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;page_from&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　引用起始页码（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;page_to&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　引用结束页码（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;section_path&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(1000)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　引用标题路径（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;content_hash&lt;/b&gt; &lt;span style='color:#2563eb'&gt;CHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　引用内容SHA-256（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;content_snapshot&lt;/b&gt; &lt;span style='color:#2563eb'&gt;MEDIUMTEXT NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　可按保留策略清理的引用文本快照（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;metadata&lt;/b&gt; &lt;span style='color:#2563eb'&gt;JSON NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　组件排名等扩展留痕（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;create_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　创建时间UTC（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;deleted&lt;/b&gt; &lt;span style='color:#2563eb'&gt;TINYINT(1)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　逻辑删除标记（NOT NULL，默认 0）&lt;/span&gt;&lt;hr&gt;&lt;b&gt;约束与索引&lt;/b&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;PK(id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_rag_citation_id(tenant_id, citation_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_rag_citation_rank(tenant_id, retrieval_id, rank_no)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_rag_citation_chunk(tenant_id, chunk_id, create_time)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_rag_citation_document(tenant_id, document_id, document_version)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=18;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="55" y="305" width="1120" height="1294" as="geometry" />
        </mxCell>
        <mxCell id="purpose_rag_knowledge_base_delete_task" value="&lt;div style='text-align:left;line-height:1.55'&gt;&lt;b style='font-size:20px'&gt;rag_knowledge_base_delete_task&lt;/b&gt;&lt;br&gt;&lt;b&gt;这张表解决什么：&lt;/b&gt;协调知识库下多个文档的向量、Chunk 和原件删除，并记录父任务进度。&lt;br&gt;&lt;b&gt;谁写入：&lt;/b&gt;知识库删除服务　　&lt;b&gt;谁读取：&lt;/b&gt;删除 Dispatcher 和恢复扫描器&lt;br&gt;&lt;b&gt;关键生命周期：&lt;/b&gt;PENDING/RUNNING/WAITING/RETRYING → COMPLETED；FAILED/DEAD&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=left;verticalAlign=middle;spacing=16;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1245" y="125" width="1120" height="150" as="geometry" />
        </mxCell>
        <mxCell id="table_rag_knowledge_base_delete_task" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;b style='font-size:21px'&gt;rag_knowledge_base_delete_task&lt;/b&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;RAG知识库级联删除任务账本&lt;/span&gt;&lt;hr&gt;&lt;b&gt;字段&lt;/b&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[PK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主键（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;task_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　删除任务业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;task_key&lt;/b&gt; &lt;span style='color:#2563eb'&gt;CHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　tenant+kb删除幂等键SHA-256（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;tenant_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租户业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;kb_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK] [REF]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　知识库业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;requested_by_user_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　发起删除的管理员用户ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;status&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　pending/running/waiting/retrying/completed/failed/dead（NOT NULL，默认 &amp;#x27;pending&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;checkpoint&lt;/b&gt; &lt;span style='color:#2563eb'&gt;JSON NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　阶段和文档计数，不含正文与凭据（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;attempt_count&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　已领取次数（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;max_attempts&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　最大领取次数（NOT NULL，默认 5）&lt;/span&gt;&lt;br&gt;&lt;b&gt;next_retry_at&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　下一次重试时间UTC（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;lease_owner&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(160)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　协调器租约持有者（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;lease_until&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租约截止UTC（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;heartbeat_at&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　最近续租UTC（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;fencing_token&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　单调栅栏令牌（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;row_version&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　行乐观锁版本（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;error_code&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　稳定错误码（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;error_message&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(1000)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　脱敏错误摘要（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;started_at&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　首次开始UTC（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;finished_at&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　最终结束UTC（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;create_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　创建时间UTC（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;update_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　更新时间UTC（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;deleted&lt;/b&gt; &lt;span style='color:#2563eb'&gt;TINYINT(1)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　逻辑删除标记（NOT NULL，默认 0）&lt;/span&gt;&lt;hr&gt;&lt;b&gt;约束与索引&lt;/b&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;PK(id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_rag_kb_delete_task_id(tenant_id, task_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_rag_kb_delete_task_kb(tenant_id, kb_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_rag_kb_delete_task_key(tenant_id, task_key)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_rag_kb_delete_due(status, next_retry_at, lease_until, id)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=18;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1245" y="305" width="1120" height="1294" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
