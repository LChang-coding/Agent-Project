        </mxCell>
        <mxCell id="a1" parent="phase4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;" value="Armory 装配全部节点 Agent&#xa;逐个注册模型、指令和 Runner" vertex="1">
