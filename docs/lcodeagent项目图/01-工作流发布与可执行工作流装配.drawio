<mxfile host="Electron">
  <diagram id="publish-runtime" name="工作流发布与可执行工作流装配">
    <mxGraphModel dx="2370" dy="1208" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3200" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F2937;" value="1. 工作流发布与可执行工作流装配" vertex="1">
          <mxGeometry height="40" width="1800" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4B5563;" value="发布只固定可运行版本；第一次启动该版本时才编译执行计划、装配各节点 Agent，并写入当前实例内存缓存。" vertex="1">
          <mxGeometry height="30" width="2500" x="40" y="60" as="geometry" />
        </mxCell>
        <mxCell id="phase1" parent="1" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#F4F8FF;strokeColor=#6C8EBF;strokeWidth=2;" value="① 发布请求与事务校验" vertex="1">
          <mxGeometry height="430" width="3100" x="40" y="110" as="geometry" />
        </mxCell>
        <mxCell id="p1" parent="phase1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" value="用户在画布点击发布&#xa;POST /workflows/{workflowId}/publish" vertex="1">
          <mxGeometry height="90" width="270" x="30" y="70" as="geometry" />
        </mxCell>
        <mxCell id="p2" parent="phase1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" value="Controller 从登录上下文取得&#xa;租户、用户和角色&#xa;不接受请求伪造身份" vertex="1">
          <mxGeometry height="90" width="260" x="350" y="70" as="geometry" />
        </mxCell>
        <mxCell id="p3" parent="phase1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" value="查询工作流和最新草稿&#xa;检查当前用户是否有修改权限" vertex="1">
          <mxGeometry height="90" width="260" x="660" y="70" as="geometry" />
        </mxCell>
        <mxCell id="p4" parent="phase1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" value="草稿、节点、边、入口节点、&#xa;路由设置和基础参数都合法？" vertex="1">
          <mxGeometry height="110" width="250" x="970" y="60" as="geometry" />
        </mxCell>
        <mxCell id="p5" parent="phase1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" value="否：拒绝发布并回滚事务&#xa;旧的已发布版本不受影响" vertex="1">
          <mxGeometry height="80" width="240" x="980" y="230" as="geometry" />
        </mxCell>
        <mxCell id="p6" parent="phase1" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" value="草稿版本 DRAFT → PUBLISHED&#xa;记录发布人和发布时间" vertex="1">
          <mxGeometry height="90" width="260" x="1280" y="70" as="geometry" />
        </mxCell>
        <mxCell id="p7" parent="phase1" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" value="工作流主记录的 publishedVersion&#xa;指向刚发布的版本" vertex="1">
          <mxGeometry height="90" width="260" x="1590" y="70" as="geometry" />
        </mxCell>
        <mxCell id="p8" parent="phase1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" value="事务提交后清除当前实例中&#xa;该工作流的旧装配缓存" vertex="1">
          <mxGeometry height="90" width="270" x="1900" y="70" as="geometry" />
        </mxCell>
        <mxCell id="p9" parent="phase1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" value="返回已发布版本和画布内容&#xa;发布阶段没有后台装配任务" vertex="1">
          <mxGeometry height="90" width="280" x="2220" y="70" as="geometry" />
        </mxCell>
        <mxCell id="p10" parent="phase1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" value="关键边界&#xa;发布成功不等于 Runtime 已注册&#xa;Agent 装配发生在第一次启动时" vertex="1">
          <mxGeometry height="110" width="380" x="2590" y="60" as="geometry" />
        </mxCell>
        <mxCell id="phase2" parent="1" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#FAF7FF;strokeColor=#9673A6;strokeWidth=2;" value="② 第一次启动时选择版本、模型和缓存" vertex="1">
          <mxGeometry height="400" width="3100" x="40" y="570" as="geometry" />
        </mxCell>
        <mxCell id="l1" parent="phase2" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" value="用户第一次启动某个发布版本&#xa;调用 loadRuntime" vertex="1">
          <mxGeometry height="90" width="260" x="30" y="70" as="geometry" />
        </mxCell>
        <mxCell id="l2" parent="phase2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" value="选择版本&#xa;未指定：最新发布版本&#xa;已指定：该版本必须已发布" vertex="1">
          <mxGeometry height="100" width="270" x="340" y="70" as="geometry" />
        </mxCell>
        <mxCell id="l3" parent="phase2" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" value="版本状态是 PUBLISHED？" vertex="1">
          <mxGeometry height="110" width="220" x="660" y="65" as="geometry" />
        </mxCell>
        <mxCell id="l4" parent="phase2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" value="否：拒绝启动&#xa;草稿或不存在版本不能运行" vertex="1">
          <mxGeometry height="80" width="240" x="650" y="230" as="geometry" />
        </mxCell>
        <mxCell id="l5" parent="phase2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" value="确定实际模型&#xa;请求指定模型 &gt; 节点模型&#xa;&gt; 工作流默认模型" vertex="1">
          <mxGeometry height="100" width="270" x="940" y="70" as="geometry" />
        </mxCell>
        <mxCell id="l6" parent="phase2" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" value="当前实例缓存键&#xa;tenantId + workflowId + version&#xa;+ modelCode" vertex="1">
          <mxGeometry height="100" width="280" x="1260" y="70" as="geometry" />
        </mxCell>
        <mxCell id="l7" parent="phase2" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" value="已有完整装配缓存？" vertex="1">
          <mxGeometry height="110" width="220" x="1590" y="65" as="geometry" />
        </mxCell>
        <mxCell id="l8" parent="phase2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" value="是：直接复用执行计划&#xa;和已经装配好的节点 Agent" vertex="1">
          <mxGeometry height="90" width="270" x="1870" y="40" as="geometry" />
        </mxCell>
        <mxCell id="l9" parent="phase2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;fontStyle=1;" value="否：进入首次编译与装配" vertex="1">
          <mxGeometry height="80" width="270" x="1870" y="220" as="geometry" />
        </mxCell>
        <mxCell id="l11" parent="phase2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" value="返回缓存中的完整 Runtime&#xa;无需再次编译和装配" vertex="1">
          <mxGeometry height="100" width="300" x="2200" y="35" as="geometry" />
        </mxCell>
        <mxCell id="l10" parent="phase2" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" value="缓存边界&#xa;只在当前 Java 进程内，不是 Redis&#xa;不同实例会各自装配一次" vertex="1">
          <mxGeometry height="100" width="390" x="2600" y="70" as="geometry" />
        </mxCell>
        <mxCell id="phase3" parent="1" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#FFF9F2;strokeColor=#D79B00;strokeWidth=2;" value="③ 编译发布版本为受控执行计划" vertex="1">
          <mxGeometry height="430" width="3100" x="40" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="c1" parent="phase3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" value="编译器重新检查&#xa;工作流类型和图结构" vertex="1">
          <mxGeometry height="90" width="250" x="30" y="70" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="phase3" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" value="图类型与环路合法？&#xa;普通工作流禁止环路&#xa;智能工作流允许受控回路" vertex="1">
          <mxGeometry height="120" width="250" x="330" y="60" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="phase3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" value="否：第一次启动失败&#xa;不进入 Agent 装配" vertex="1">
          <mxGeometry height="80" width="230" x="340" y="250" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="phase3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" value="为每个 LLM 节点生成&#xa;独立内部 Agent ID、模型配置、&#xa;指令和 Runner" vertex="1">
          <mxGeometry height="100" width="280" x="640" y="70" as="geometry" />
        </mxCell>
        <mxCell id="c5" parent="phase3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" value="把画布边编译成当前节点的&#xa;合法出口和目标范围&#xa;不能跳到画布外节点" vertex="1">
          <mxGeometry height="100" width="290" x="970" y="70" as="geometry" />
        </mxCell>
        <mxCell id="c6" parent="phase3" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" value="固定执行约束&#xa;根节点、路由协议、maxSteps、Token 上限&#xa;allowedTargetNodeIds、maxVisits" vertex="1">
          <mxGeometry height="110" width="320" x="1310" y="70" as="geometry" />
        </mxCell>
        <mxCell id="c7" parent="phase3" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" value="计算整份执行计划的&#xa;SHA-256 定义摘要&#xa;供运行和工具调用核对版本" vertex="1">
          <mxGeometry height="100" width="290" x="1680" y="70" as="geometry" />
        </mxCell>
        <mxCell id="c8" parent="phase3" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" value="目标设计与代码边界&#xa;发布校验和首次编译校验分处两阶段&#xa;若规则不一致，可能发布成功但首次启动失败" vertex="1">
          <mxGeometry height="120" width="480" x="2100" y="60" as="geometry" />
        </mxCell>
        <mxCell id="phase4" parent="1" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#F3FCF8;strokeColor=#67C9A3;strokeWidth=2;" value="④ 全量装配、原子写缓存与返回 Runtime" vertex="1">
