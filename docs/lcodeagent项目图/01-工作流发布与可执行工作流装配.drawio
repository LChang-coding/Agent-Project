        <mxCell id="a5" parent="phase4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" value="返回可直接执行的工作流&#xa;已装配 Agent + 节点配置&#xa;+ 合法出边 + 定义摘要" vertex="1">
