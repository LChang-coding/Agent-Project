        <mxCell id="a4" parent="phase4" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" value="是：完整 Runtime 写入&#xa;当前应用实例内存缓存" vertex="1">
          <mxGeometry height="100" width="280" x="680" y="70" as="geometry" />
