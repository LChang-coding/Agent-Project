<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="31.0.2">
  <diagram id="trace-id-propagation" name="用同一个TraceID串起同步请求与后台处理日志">
    <mxGraphModel dx="3000" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3200" pageHeight="2100" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="10. 用同一个 Trace ID 串起同步请求与后台处理日志" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2100" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="本图范围：HTTP 入口生成或接收 Trace ID → 保存到 Run、消息、工具、RAG 和工作流事件 → 显式带入线程池与 Kafka → 响应返回并清理线程数据。这里是项目级业务编号，不是完整 OpenTelemetry Trace。" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="2950" height="30" as="geometry"/></mxCell>

        <mxCell id="phase1" value="① HTTP 入口确定本次请求的 Trace ID" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#F4F8FF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="3100" height="370" as="geometry"/></mxCell>
        <mxCell id="a1" value="客户端发起 HTTP 请求&#xa;可选请求头 X-Trace-Id" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="30" y="80" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="a2" value="TraceIdFilter 读取请求头" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="340" y="85" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="a3" value="编号安全吗？&#xa;1~64 位，只允许字母、数字&#xa;点、下划线、冒号和短横线" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="phase1"><mxGeometry x="640" y="70" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="a4" value="合法：沿用调用方编号" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="960" y="45" width="230" height="75" as="geometry"/></mxCell>
        <mxCell id="a5" value="缺失、过长或含不安全字符&#xa;服务端生成 UUID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="960" y="155" width="270" height="80" as="geometry"/></mxCell>
        <mxCell id="a6" value="把最终编号放入 TraceContext 和 MDC&#xa;当前线程日志自动带上 traceId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="1290" y="75" width="310" height="100" as="geometry"/></mxCell>
        <mxCell id="a7" value="同时写入 request attribute&#xa;统一异常处理仍能找到同一编号" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="1660" y="80" width="290" height="90" as="geometry"/></mxCell>
        <mxCell id="a8" value="响应头提前写回 X-Trace-Id&#xa;并允许浏览器跨域读取" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="2010" y="80" width="290" height="90" as="geometry"/></mxCell>
        <mxCell id="a9" value="认证过滤器继续把 tenantId、userId&#xa;放入同一个日志上下文" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="2360" y="80" width="310" height="90" as="geometry"/></mxCell>
        <mxCell id="a10" value="Controller 和领域服务开始处理&#xa;同步日志都使用该编号" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" vertex="1" parent="phase1"><mxGeometry x="2730" y="80" width="290" height="90" as="geometry"/></mxCell>

        <mxCell id="phase2" value="② 运行记录、模型、工具、RAG 和工作流事件继续保存同一编号" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#FAF7FF;strokeColor=#9673A6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="3100" height="430" as="geometry"/></mxCell>
        <mxCell id="b1" value="创建 Chat Run / 智能工作流运行&#xa;保存 chat_run.trace_id" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="30" y="80" width="280" height="95" as="geometry"/></mxCell>
        <mxCell id="b2" value="用户消息和助手消息&#xa;沿用 Run 的编号&#xa;保存 chat_message.trace_id" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="360" y="75" width="290" height="105" as="geometry"/></mxCell>
        <mxCell id="b3" value="ChatService 把 Trace ID&#xa;放入 ADK 只读运行状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="700" y="80" width="270" height="95" as="geometry"/></mxCell>
        <mxCell id="b4" value="模型调用日志插件&#xa;从线程和运行状态记录同一编号" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="1020" y="80" width="280" height="95" as="geometry"/></mxCell>
        <mxCell id="b5" value="Agent 调用工具&#xa;GatewayAdkTool 从服务端状态恢复 Trace ID&#xa;模型参数不能修改它" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="phase2"><mxGeometry x="1350" y="70" width="320" height="115" as="geometry"/></mxCell>
        <mxCell id="b6" value="Tool Gateway 的开始、成功、失败审计&#xa;以及工作流工具事件保存该编号" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="1720" y="75" width="320" height="105" as="geometry"/></mxCell>
        <mxCell id="b7" value="Agent 调用 RAG&#xa;检索请求、阶段审计、最终引用记录&#xa;继续使用同一编号" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="phase2"><mxGeometry x="2090" y="70" width="320" height="115" as="geometry"/></mxCell>
        <mxCell id="b8" value="工作流节点开始、结束、路径选择&#xa;和最终事件都使用 Run 中的根编号" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="2460" y="75" width="320" height="105" as="geometry"/></mxCell>
        <mxCell id="b9" value="运行根编号与查看请求编号分开&#xa;SSE 订阅 / 状态查询有自己的 operationTraceId&#xa;但返回数据仍带 Run 的 traceId" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="phase2"><mxGeometry x="1350" y="245" width="430" height="105" as="geometry"/></mxCell>
        <mxCell id="b10" value="即使文件日志已经滚动&#xa;Run、消息、工具、RAG 和工作流事件中&#xa;仍保存可用于关联的业务编号" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="phase2"><mxGeometry x="2240" y="245" width="420" height="105" as="geometry"/></mxCell>

        <mxCell id="phase3" value="③ 切换线程池或 Kafka 时显式带入，并在结束后清理" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#FFF9F2;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="3100" height="450" as="geometry"/></mxCell>
        <mxCell id="c1" value="业务提交线程池任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="30" y="85" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="c2" value="提交前复制当前 traceId&#xa;tenantId 和 userId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="310" y="80" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="c3" value="工作线程开始时放入自己的上下文&#xa;智能工作流明确使用 Run 根 traceId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="620" y="75" width="310" height="100" as="geometry"/></mxCell>
        <mxCell id="c4" value="后台步骤继续记录日志" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="980" y="85" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="c5" value="任务结束恢复线程原有内容&#xa;防止线程复用时串到下一位用户" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="1270" y="75" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="c6" value="业务通过 Kafka 延后处理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="1640" y="85" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="c7" value="生产者把 Trace ID 保存到任务记录&#xa;并写入 Kafka 消息" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="1940" y="75" width="290" height="100" as="geometry"/></mxCell>
        <mxCell id="c8" value="消费者从可信任务字段恢复&#xa;Trace ID 和租户身份&#xa;再回查 MySQL 执行真实业务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="2280" y="70" width="310" height="110" as="geometry"/></mxCell>
        <mxCell id="c9" value="消费结束清理 TraceContext&#xa;TenantContext 和 MDC&#xa;避免 Kafka 线程处理下一条时串线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="phase3"><mxGeometry x="2640" y="70" width="330" height="110" as="geometry"/></mxCell>
        <mxCell id="c10" value="能力边界&#xa;只有 TraceableThreadPoolExecutor 或显式包装的任务会自动复制&#xa;新建原生线程、第三方回调和新消费者仍需主动接入" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="phase3"><mxGeometry x="900" y="245" width="520" height="110" as="geometry"/></mxCell>
        <mxCell id="c11" value="Kafka 消费线程不会继承 HTTP ThreadLocal&#xa;必须依靠消息和数据库任务字段恢复" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="phase3"><mxGeometry x="2130" y="250" width="430" height="100" as="geometry"/></mxCell>

        <mxCell id="phase4" value="④ 请求结束、用户查询日志与当前边界" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#F3FCF8;strokeColor=#67C9A3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1450" width="3100" height="550" as="geometry"/></mxCell>
        <mxCell id="d1" value="普通 JSON 响应体自动补充 traceId&#xa;统一错误响应也从 request attribute 读取" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="30" y="75" width="330" height="105" as="geometry"/></mxCell>
        <mxCell id="d2" value="记录 HTTP 状态和耗时&#xa;响应头继续返回 X-Trace-Id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="420" y="80" width="290" height="95" as="geometry"/></mxCell>
        <mxCell id="d3" value="清理当前 HTTP 线程的&#xa;Trace ID、租户和用户信息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="770" y="80" width="290" height="95" as="geometry"/></mxCell>
        <mxCell id="d4" value="用户拿响应中的编号&#xa;查询这次业务过程的日志" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" vertex="1" parent="phase4"><mxGeometry x="1120" y="80" width="290" height="95" as="geometry"/></mxCell>
        <mxCell id="d5" value="日志中 traceId 是正文结构化字段&#xa;不是 Loki 高基数标签&#xa;可按字段查询，避免大量标签组合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="phase4"><mxGeometry x="1470" y="70" width="330" height="115" as="geometry"/></mxCell>
        <mxCell id="d6" value="准确能力名称&#xa;这是项目级业务 Trace ID 透传&#xa;没有 spanId、父子关系或 W3C traceparent" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="phase4"><mxGeometry x="1860" y="70" width="350" height="115" as="geometry"/></mxCell>
        <mxCell id="d7" value="日志完整性边界&#xa;异步文件日志队列满时可能丢日志&#xa;数据库业务记录仍保留，但 Loki 不保证每一步永远齐全" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="phase4"><mxGeometry x="2270" y="65" width="380" height="125" as="geometry"/></mxCell>
        <mxCell id="d8" value="部署边界&#xa;本地代码能证明采集配置和查询字段&#xa;远端 Loki 保留、Grafana 数据源和在线状态需部署环境验证" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="phase4"><mxGeometry x="2700" y="65" width="360" height="125" as="geometry"/></mxCell>
        <mxCell id="legend" value="图例" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9CA3AF;verticalAlign=top;fontStyle=1;fontSize=13;container=1;pointerEvents=0;" vertex="1" parent="phase4"><mxGeometry x="1910" y="285" width="800" height="170" as="geometry"/></mxCell>
        <mxCell id="lg1" value="服务 / 入口" style="rounded=1;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="legend"><mxGeometry x="20" y="40" width="130" height="35" as="geometry"/></mxCell>
        <mxCell id="lg2" value="上下文传播" style="rounded=1;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="legend"><mxGeometry x="170" y="40" width="130" height="35" as="geometry"/></mxCell>
        <mxCell id="lg3" value="判断 / 边界" style="rounded=1;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="legend"><mxGeometry x="320" y="40" width="130" height="35" as="geometry"/></mxCell>
        <mxCell id="lg4" value="持久化 / 成功" style="rounded=1;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="legend"><mxGeometry x="470" y="40" width="150" height="35" as="geometry"/></mxCell>
        <mxCell id="lg5" value="清理 / 风险" style="rounded=1;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="legend"><mxGeometry x="100" y="95" width="150" height="35" as="geometry"/></mxCell>
        <mxCell id="lg6" value="虚线：实现或部署边界" style="rounded=1;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="legend"><mxGeometry x="290" y="95" width="280" height="35" as="geometry"/></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="合法" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="重新生成" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="a3" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a4" target="a6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a6" target="a7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a7" target="a8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a8" target="a9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a9" target="a10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a10" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="b7" target="b8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e19" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="b8" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
