<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="31.0.2">
  <diagram id="redis-context-assembly" name="Redis保存近期对话并组装模型上下文">
    <mxGraphModel dx="3000" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3200" pageHeight="2050" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="8. Redis 保存近期对话并组装模型上下文" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="本图范围：消息先落 MySQL → Redis ZSet 缓存近期消息 → 下次调用模型时读取摘要和消息 → 缓存不完整就回到 MySQL → 按各类额度和总窗口组装完整背景信息。" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="2800" height="30" as="geometry"/></mxCell>

        <mxCell id="phase1" value="① 消息先保存到 MySQL，再更新 Redis 近期消息" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#F4F8FF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="3100" height="370" as="geometry"/></mxCell>
        <mxCell id="a1" value="用户消息或助手回答&#xa;先写入 MySQL 完整历史" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="30" y="80" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="a2" value="为消息分配会话内递增 sequenceNo&#xa;用它恢复真实对话顺序" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="340" y="80" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="a3" value="追加到 Redis ZSet&#xa;ctx:recent:{tenant}:{user}:{session}&#xa;score = sequenceNo" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="phase1"><mxGeometry x="680" y="70" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="a4" value="同一 sequenceNo 再写入&#xa;先删除旧 JSON，再保存新 JSON&#xa;避免同一位置出现两份消息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="1040" y="75" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="a5" value="只保留最近 100 条&#xa;开发配置下 30 分钟无访问自动过期&#xa;防止长期会话无限占用 Redis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="phase1"><mxGeometry x="1400" y="75" width="310" height="100" as="geometry"/></mxCell>
        <mxCell id="a6" value="Redis 写入成功？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="1770" y="75" width="210" height="100" as="geometry"/></mxCell>
        <mxCell id="a7" value="成功：近期读取可直接使用缓存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="2040" y="45" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="a8" value="失败：只记录日志&#xa;MySQL 原始消息仍然完整&#xa;下一次读取时可以重新建立缓存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="2040" y="155" width="290" height="95" as="geometry"/></mxCell>
        <mxCell id="a9" value="核心原则&#xa;MySQL 保存完整历史&#xa;Redis 只负责加快读取" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" vertex="1" parent="phase1"><mxGeometry x="2430" y="75" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="a10" value="不同租户、用户和会话使用不同 Key&#xa;缓存数据不能跨范围混用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="2770" y="80" width="280" height="90" as="geometry"/></mxCell>

        <mxCell id="phase2" value="② 下次模型调用：先读摘要，再读取它尚未覆盖的近期消息" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#FAF7FF;strokeColor=#9673A6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="3100" height="430" as="geometry"/></mxCell>
        <mxCell id="b1" value="准备调用模型&#xa;确认 Context Manager 已开启&#xa;确定本次可见消息最大 sequence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="30" y="75" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="b2" value="计算本轮总额度&#xa;模型窗口 - 回答预留 8192&#xa;- 计数误差余量 2048" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="phase2"><mxGeometry x="390" y="70" width="270" height="115" as="geometry"/></mxCell>
        <mxCell id="b3" value="读取当前长期摘要&#xa;先查 ctx:snapshot:{tenant}:{user}:{session}" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="phase2"><mxGeometry x="720" y="75" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="b4" value="摘要缓存命中？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="1080" y="75" width="210" height="105" as="geometry"/></mxCell>
        <mxCell id="b5" value="未命中或读取失败&#xa;从 MySQL 读取当前有效摘要&#xa;成功后重新写入 Redis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="1060" y="235" width="280" height="95" as="geometry"/></mxCell>
        <mxCell id="b6" value="从摘要 coveredToSequence + 1 开始&#xa;只查询本次调用可见且仍有效的消息&#xa;取消或被新要求替代的旧消息不会进入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="phase2"><mxGeometry x="1360" y="70" width="340" height="115" as="geometry"/></mxCell>
        <mxCell id="b7" value="从 Redis ZSet 读取所需序号区间" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="1760" y="80" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="b8" value="缓存是否连续覆盖&#xa;请求起点到终点？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="2100" y="70" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="b9" value="缺开头、结尾或中间任一序号&#xa;放弃这次缓存结果&#xa;从 MySQL 读取完整区间并回填 Redis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="phase2"><mxGeometry x="2080" y="235" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="b10" value="连续完整：按 sequenceNo&#xa;得到稳定顺序的近期消息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="2400" y="80" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="b11" value="cacheHit 只表示长期摘要是否直接命中 Redis&#xa;近期消息缓存只是加速，不代表完整历史" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="phase2"><mxGeometry x="2730" y="70" width="340" height="105" as="geometry"/></mxCell>

        <mxCell id="phase3" value="③ 按消息边界和内容类型额度选择完整背景" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#FFF9F2;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="3100" height="420" as="geometry"/></mxCell>
        <mxCell id="c1" value="从最新消息向前选择&#xa;连续且完整的消息&#xa;近期对话单独最多 8192 Token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="30" y="75" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="c2" value="加入下一条会超出额度？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="390" y="75" width="240" height="105" as="geometry"/></mxCell>
        <mxCell id="c3" value="在消息边界停止&#xa;不把一条消息截成半段&#xa;最新一条再长也至少完整保留" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="690" y="75" width="290" height="105" as="geometry"/></mxCell>
        <mxCell id="c4" value="把五类内容分别包装成候选&#xa;长期摘要 / 最近对话 / 上游节点输出&#xa;附件 / 按需 RAG 结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="phase3"><mxGeometry x="1040" y="70" width="340" height="115" as="geometry"/></mxCell>
        <mxCell id="c5" value="按优先级依次选择&#xa;摘要 → 最近对话 → 上游输出 → 附件 → RAG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="1440" y="75" width="310" height="105" as="geometry"/></mxCell>
        <mxCell id="c6" value="每一类先遵守自己的额度&#xa;全部内容还要共同遵守本轮总额度" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="1810" y="70" width="290" height="115" as="geometry"/></mxCell>
        <mxCell id="c7" value="某段完整内容放不下&#xa;整段不加入，不截断附件或引用证据&#xa;并记录裁剪原因" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="phase3"><mxGeometry x="2160" y="70" width="310" height="115" as="geometry"/></mxCell>
        <mxCell id="c8" value="生成最终背景信息&#xa;记录各类实际 Token、消息范围&#xa;以及是否发生裁剪" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="2530" y="75" width="300" height="105" as="geometry"/></mxCell>

        <mxCell id="phase4" value="④ 交给 Agent，并保留缓存与部署边界" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#F3FCF8;strokeColor=#67C9A3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1420" width="3100" height="520" as="geometry"/></mxCell>
        <mxCell id="d1" value="ChatService 把最终背景信息&#xa;连同当前用户问题交给 Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;" vertex="1" parent="phase4"><mxGeometry x="30" y="80" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="d2" value="模型获得：长期摘要 + 最近有效对话&#xa;+ 上游输出 + 附件 + 按需检索资料&#xa;总量不超过当前模型窗口" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontStyle=1;" vertex="1" parent="phase4"><mxGeometry x="390" y="70" width="350" height="115" as="geometry"/></mxCell>
        <mxCell id="d3" value="Redis 丢失、过期或暂时不可用&#xa;不会导致对话永久丢失&#xa;只会多一次 MySQL 回查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="800" y="75" width="310" height="105" as="geometry"/></mxCell>
        <mxCell id="d4" value="取消或追加新要求后&#xa;已失效的旧回答不会再次进入模型上下文" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="1170" y="80" width="300" height="95" as="geometry"/></mxCell>
        <mxCell id="d5" value="部署边界&#xa;主配置默认关闭 Context Manager&#xa;只有明确开启后这条 Redis 记忆链路才生效" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="phase4"><mxGeometry x="1530" y="70" width="350" height="115" as="geometry"/></mxCell>
        <mxCell id="d6" value="能力边界&#xa;最近消息最多缓存 100 条&#xa;读取区间不完整时必须整段回到 MySQL" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="phase4"><mxGeometry x="1940" y="70" width="340" height="115" as="geometry"/></mxCell>
        <mxCell id="legend" value="图例" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9CA3AF;verticalAlign=top;fontStyle=1;fontSize=13;container=1;pointerEvents=0;" vertex="1" parent="phase4"><mxGeometry x="2320" y="55" width="700" height="220" as="geometry"/></mxCell>
        <mxCell id="lg1" value="缓存 / 服务" style="rounded=1;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="legend"><mxGeometry x="20" y="40" width="130" height="35" as="geometry"/></mxCell>
        <mxCell id="lg2" value="Agent / 内容" style="rounded=1;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="legend"><mxGeometry x="170" y="40" width="130" height="35" as="geometry"/></mxCell>
        <mxCell id="lg3" value="判断 / 预算" style="rounded=1;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="legend"><mxGeometry x="320" y="40" width="130" height="35" as="geometry"/></mxCell>
        <mxCell id="lg4" value="数据库 / 成功" style="rounded=1;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="legend"><mxGeometry x="470" y="40" width="150" height="35" as="geometry"/></mxCell>
        <mxCell id="lg5" value="失败 / 回退" style="rounded=1;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="legend"><mxGeometry x="100" y="95" width="150" height="35" as="geometry"/></mxCell>
        <mxCell id="lg6" value="虚线：部署或能力边界" style="rounded=1;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="legend"><mxGeometry x="290" y="95" width="280" height="35" as="geometry"/></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="成功" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="a6" target="a7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="失败" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;" edge="1" parent="1" source="a6" target="a8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a7" target="a9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a9" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="未命中" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="摘要可用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b4" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="b7" target="b8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" value="完整" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b8" target="b10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e19" value="不完整" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;" edge="1" parent="1" source="b8" target="b9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="b9" target="b10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e21" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="b10" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e23" value="达到边界" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e24" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell>
