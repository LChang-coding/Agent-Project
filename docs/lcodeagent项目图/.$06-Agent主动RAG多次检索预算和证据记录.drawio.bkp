<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="31.0.2">
  <diagram id="agent-rag-budget-evidence" name="Agent主动RAG多次检索预算和证据记录">
    <mxGraphModel dx="3000" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3200" pageHeight="2050" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="6. Agent 主动 RAG：多次检索、预算控制和证据记录" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1900" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="本图范围：本轮发现 rag_retrieve → Agent 自主决定检索次数 → 先占预算再按实际使用结算 → 记录真正交给模型的证据 → 最终回答检查引用。" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="2650" height="30" as="geometry"/></mxCell>

        <mxCell id="phase1" value="① 本轮是否向 Agent 提供 RAG 工具" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#F4F8FF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="3100" height="350" as="geometry"/></mxCell>
        <mxCell id="a1" value="本次会话采用 AGENT_TOOL&#xa;RAG 没有关闭&#xa;当前 Agent 节点允许检索" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="30" y="75" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="a2" value="PlatformToolResolver&#xa;把 rag_retrieve 加入&#xa;这一轮可见工具清单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="350" y="75" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="a3" value="Agent 根据用户问题和已有结果&#xa;自主判断现在是否需要检索&#xa;系统不强制一定调用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;" vertex="1" parent="phase1"><mxGeometry x="650" y="70" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="a4" value="调用 rag_retrieve&#xa;模型只能提交 query&#xa;和可选 maxContextTokens" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="1000" y="75" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="a5" value="参数范围检查&#xa;query 最长 2000 字符&#xa;Token：128~8000，默认 8000" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="phase1"><mxGeometry x="1320" y="65" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="a6" value="身份和知识库范围全部来自&#xa;服务端本次运行保存的信息&#xa;模型不能切换租户、用户或 bindingIds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="phase1"><mxGeometry x="1630" y="70" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="a7" value="Tool Gateway 统一处理&#xa;运行是否可继续 / 重复调用保护&#xa;开始、成功和失败审计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="2010" y="70" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="a8" value="参数不合法或运行已结束&#xa;返回明确错误&#xa;不会进入检索服务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="2380" y="70" width="270" height="100" as="geometry"/></mxCell>
        <mxCell id="a9" value="工具可用并通过检查&#xa;进入预算与检索阶段" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" vertex="1" parent="phase1"><mxGeometry x="2720" y="75" width="260" height="90" as="geometry"/></mxCell>

        <mxCell id="phase2" value="② 先占住预算，再同步完成检索" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#FFF9F2;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="3100" height="420" as="geometry"/></mxCell>
        <mxCell id="b1" value="按 tenant + user + run&#xa;先占 1 次调用和本次最大 Token&#xa;并发检索也先各自占住额度" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="30" y="75" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="b2" value="本次 Run 仍有额度？&#xa;默认最多 3 次检索&#xa;累计最多 8000 Token" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="phase2"><mxGeometry x="370" y="70" width="250" height="115" as="geometry"/></mxCell>
        <mxCell id="b3" value="否：RAG_TOOL_BUDGET_EXCEEDED&#xa;不调用 Embedding / Qdrant / Rerank&#xa;Agent 只能使用已有资料继续作答" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="phase2"><mxGeometry x="350" y="235" width="290" height="100" as="geometry"/></mxCell>
        <mxCell id="b4" value="RagRetrievalService&#xa;只在本次运行保存的绑定范围内&#xa;完成召回、融合和重排" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="690" y="75" width="290" height="105" as="geometry"/></mxCell>
        <mxCell id="b5" value="补充父块和相邻块&#xa;按完整引用计算上下文 Token&#xa;不返回无法核对出处的半段资料" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="1030" y="75" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="b6" value="PresentationService 包装资料&#xa;标明它们只是参考内容&#xa;文档中的命令没有指令权限" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="1380" y="75" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="b7" value="转义 XML 特殊字符&#xa;每条资料携带平台生成的 citationId&#xa;防止正文改变提示词结构" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="1730" y="75" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="b8" value="检索期间是否被取消？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="2090" y="75" width="230" height="105" as="geometry"/></mxCell>
        <mxCell id="b9" value="已取消：丢弃迟到结果&#xa;不登记为可引用证据&#xa;归还本次预算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="2080" y="235" width="250" height="95" as="geometry"/></mxCell>
        <mxCell id="b10" value="未取消：按实际返回 Token 结算&#xa;归还预留但未使用的差额&#xa;空结果仍算一次成功检索" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="phase2"><mxGeometry x="2380" y="75" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="b11" value="参数错误或检索异常&#xa;调用次数和 Token 预留都归还&#xa;不会消耗本次 Run 的有效额度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="phase2"><mxGeometry x="2720" y="75" width="300" height="105" as="geometry"/></mxCell>

        <mxCell id="phase3" value="③ 记录证据，Agent 根据结果决定是否继续检索" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#FAF7FF;strokeColor=#9673A6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="3100" height="390" as="geometry"/></mxCell>
        <mxCell id="c1" value="按 tenant + user + session + run&#xa;+ 本次模型调用编号&#xa;记录真正交给模型的证据" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="30" y="75" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="c2" value="返回给 Agent&#xa;context / citations / 命中数&#xa;Token / 耗时 / 是否降级" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="390" y="75" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="c3" value="资料是否足够回答？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="730" y="75" width="230" height="105" as="geometry"/></mxCell>
        <mxCell id="c4" value="足够：继续生成答案&#xa;引用需要使用返回的 citationId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="1020" y="55" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="c5" value="不足或发现新线索：&#xa;Agent 自己换成更具体的问题&#xa;再次调用 rag_retrieve" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;" vertex="1" parent="phase3"><mxGeometry x="1020" y="175" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="c6" value="再次调用仍从预算检查开始&#xa;不是代码硬编码的第二次检索&#xa;达到次数或 Token 上限后会被拒绝" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="phase3"><mxGeometry x="1370" y="175" width="310" height="100" as="geometry"/></mxCell>
        <mxCell id="c7" value="节点结束时只取回&#xa;该模型调用编号下实际登记的证据&#xa;不会把其他运行资料混进来" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="1740" y="75" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="c8" value="工作流结束时汇总&#xa;各节点成功检索产生的证据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="2100" y="75" width="270" height="105" as="geometry"/></mxCell>
        <mxCell id="c9" value="问题改写能力边界&#xa;当前没有平台自动改写器&#xa;问题调整来自 Agent 再次调用时自行改写" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="phase3"><mxGeometry x="2440" y="65" width="350" height="115" as="geometry"/></mxCell>

        <mxCell id="phase4" value="④ 最终回答引用检查与当前能力边界" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#F3FCF8;strokeColor=#67C9A3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1360" width="3100" height="580" as="geometry"/></mxCell>
        <mxCell id="d1" value="从最终回答提取&#xa;cite_xxx 格式引用编号" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="30" y="75" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="d2" value="与本次运行证据清单&#xa;逐项比对" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="340" y="70" width="230" height="100" as="geometry"/></mxCell>
        <mxCell id="d3" value="NO_RAG&#xa;本次运行没有使用 RAG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="phase4"><mxGeometry x="650" y="55" width="210" height="75" as="geometry"/></mxCell>
        <mxCell id="d4" value="RAG_AVAILABLE_UNUSED&#xa;有资料但回答没有引用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="phase4"><mxGeometry x="650" y="150" width="210" height="75" as="geometry"/></mxCell>
        <mxCell id="d5" value="VALID&#xa;所有引用都能找到对应证据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="phase4"><mxGeometry x="920" y="55" width="220" height="75" as="geometry"/></mxCell>
        <mxCell id="d6" value="INVALID_CITATIONS&#xa;出现证据清单外的引用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="phase4"><mxGeometry x="920" y="150" width="220" height="75" as="geometry"/></mxCell>
        <mxCell id="d7" value="把检查状态、检索批次&#xa;实际使用出处写入&#xa;最终助手消息元数据" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="1220" y="80" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="d8" value="运行结束后清除&#xa;当前进程中的临时证据和预算记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="1570" y="80" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="d9" value="当前实现：预算和证据存在单个 Java 进程&#xa;多实例不共享，应用重启后会丢失&#xa;目标设计应改用 Redis 或数据库原子保存" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="phase4"><mxGeometry x="1930" y="60" width="380" height="125" as="geometry"/></mxCell>
        <mxCell id="d10" value="当前实现：非法引用只记录检查结果&#xa;不会阻止原回答保存&#xa;目标设计可在落库前删除、拒绝或要求 Agent 修正" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="phase4"><mxGeometry x="2380" y="60" width="390" height="125" as="geometry"/></mxCell>
        <mxCell id="legend" value="图例" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9CA3AF;verticalAlign=top;fontStyle=1;fontSize=13;container=1;pointerEvents=0;" vertex="1" parent="phase4"><mxGeometry x="1900" y="270" width="870" height="170" as="geometry"/></mxCell>
        <mxCell id="lg1" value="入口 / 服务" style="rounded=1;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="legend"><mxGeometry x="20" y="40" width="130" height="35" as="geometry"/></mxCell>
        <mxCell id="lg2" value="Agent / 模型" style="rounded=1;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="legend"><mxGeometry x="170" y="40" width="130" height="35" as="geometry"/></mxCell>
        <mxCell id="lg3" value="判断 / 预算" style="rounded=1;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="legend"><mxGeometry x="320" y="40" width="130" height="35" as="geometry"/></mxCell>
        <mxCell id="lg4" value="保存 / 成功" style="rounded=1;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="legend"><mxGeometry x="470" y="40" width="130" height="35" as="geometry"/></mxCell>
        <mxCell id="lg5" value="失败 / 取消" style="rounded=1;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="legend"><mxGeometry x="620" y="40" width="130" height="35" as="geometry"/></mxCell>
        <mxCell id="lg6" value="虚线：当前边界 / 目标设计" style="rounded=1;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="legend"><mxGeometry x="230" y="95" width="390" height="35" as="geometry"/></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="决定检索" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="合法" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="非法" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;" edge="1" parent="1" source="a5" target="a8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1460" y="400"/><mxPoint x="2515" y="400"/></Array></mxGeometry></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a6" target="a7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="通过" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="a7" target="a9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a9" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="有额度" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="b2" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="超限" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="b7" target="b8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" value="已取消" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;" edge="1" parent="1" source="b8" target="b9"><mxGeometry relative="1" as="geometry"/></mxCell>
