<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="31.0.2">
  <diagram id="dynamic-tools" name="Agent每轮动态发现可用工具">
    <mxGraphModel dx="3000" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3200" pageHeight="2150" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="4. Agent 每轮动态发现可用工具" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="每次模型请求前，系统依据可信身份、最新目录状态和当前节点范围重新生成工具清单；不在清单里的工具无法被模型调用。" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="2600" height="30" as="geometry"/></mxCell>

        <mxCell id="phase1" value="① ChatService 写入本轮可信运行状态" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#F4F8FF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="3100" height="380" as="geometry"/></mxCell>
        <mxCell id="s1" value="ChatService 准备执行&#xa;某个 Agent 节点" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="30" y="80" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="s2" value="写入 ADK 只读运行状态&#xa;tenantId、userId、sessionId、runId&#xa;上下文版本和 traceId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="350" y="70" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="s3" value="智能工作流额外写入&#xa;当前 nodeId、nodeExecutionId、定义摘要&#xa;节点 Skill/MCP 范围、RAG 开关和合法路径" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="710" y="60" width="340" height="130" as="geometry"/></mxCell>
        <mxCell id="s4" value="ADK 在本轮请求模型前&#xa;调用 GatewayToolset.getTools" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;" vertex="1" parent="phase1"><mxGeometry x="1110" y="75" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="s5" value="GatewayToolset 只读取服务端状态&#xa;不读取模型生成的身份、节点或路径文本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="1470" y="70" width="330" height="110" as="geometry"/></mxCell>
        <mxCell id="s6" value="身份边界&#xa;模型不能提交 tenantId、userId 或 runId&#xa;来扩大工具查询范围" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="1910" y="70" width="380" height="110" as="geometry"/></mxCell>

        <mxCell id="phase2" value="② ToolResolver 查最新目录并按权限、状态和节点范围过滤" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#FAF7FF;strokeColor=#9673A6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="3100" height="470" as="geometry"/></mxCell>
        <mxCell id="d1" value="检查 tenantId 和 userId 完整？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="30" y="65" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="d2" value="否：本轮装配失败&#xa;缺少隔离条件时不查询工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="30" y="250" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="d3" value="按 tenantId + userId 查询数据库&#xa;读取当前 Skill 和 MCP 目录" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="330" y="70" width="290" height="100" as="geometry"/></mxCell>
        <mxCell id="d4" value="只保留当前用户有权使用、&#xa;已发布且存在激活版本的 Skill 和 MCP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="680" y="60" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="d5" value="按当前节点 skillIds / mcpIds&#xa;删除未配置的普通工具&#xa;静态与智能工作流都携带节点范围" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="1060" y="60" width="330" height="120" as="geometry"/></mxCell>
        <mxCell id="d6" value="目录变化下一轮生效&#xa;刚发布、停用或权限变化&#xa;不需要重启应用或重新装配 Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="1450" y="60" width="330" height="120" as="geometry"/></mxCell>
        <mxCell id="d7" value="性能边界&#xa;普通 Skill/MCP 清单当前不做 Java 内存缓存&#xa;目录很大时每轮查库会增加数据库压力" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="1900" y="60" width="430" height="120" as="geometry"/></mxCell>

        <mxCell id="phase3" value="③ 按本轮运行条件临时加入平台工具" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#FFF9F2;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="3100" height="430" as="geometry"/></mxCell>
        <mxCell id="p1" value="PlatformToolResolver&#xa;读取可信会话和节点条件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;fontStyle=1;" vertex="1" parent="phase3"><mxGeometry x="30" y="70" width="270" height="100" as="geometry"/></mxCell>
        <mxCell id="p2" value="满足 RAG 条件？&#xa;AGENT_TOOL 模式、RAG 未关闭、节点允许&#xa;且存在可信知识库范围" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="360" y="55" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="p3" value="是：加入 rag_retrieve&#xa;知识库范围来自服务端状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="720" y="70" width="270" height="100" as="geometry"/></mxCell>
        <mxCell id="p4" value="满足路由条件？&#xa;智能工作流 TOOL_V2、非终点&#xa;且当前节点存在合法出边" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="1050" y="55" width="290" height="130" as="geometry"/></mxCell>
        <mxCell id="p5" value="是：加入 select_workflow_route&#xa;routeKey 枚举来自当前节点合法出边" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="1400" y="65" width="310" height="110" as="geometry"/></mxCell>
        <mxCell id="p6" value="本轮只是补选路径？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="1770" y="65" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="p7" value="是：删除其他全部工具&#xa;只保留 select_workflow_route&#xa;不能顺便再调用 MCP、Skill 或 RAG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="2070" y="55" width="320" height="130" as="geometry"/></mxCell>
        <mxCell id="p8" value="否：保留过滤后的 Skill、MCP&#xa;以及满足条件的平台工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="2070" y="250" width="320" height="90" as="geometry"/></mxCell>

        <mxCell id="phase4" value="④ 固定本轮函数声明并交给模型" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#F3FCF8;strokeColor=#67C9A3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1480" width="3100" height="450" as="geometry"/></mxCell>
        <mxCell id="f1" value="检查最终函数名是否重复&#xa;规范化后同名？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="30" y="65" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="f2" value="是：拒绝本轮装配&#xa;防止模型调用落到错误工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="30" y="260" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="f3" value="为每个目录项创建 GatewayAdkTool&#xa;统一包装 Skill、MCP 和平台工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="350" y="70" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="f4" value="固定这一轮模型看到的&#xa;函数名、说明、参数类型、必填字段和版本" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="730" y="60" width="330" height="130" as="geometry"/></mxCell>
        <mxCell id="f5" value="把函数清单交给模型&#xa;模型只能决定是否调用清单内工具" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" vertex="1" parent="phase4"><mxGeometry x="1120" y="65" width="310" height="120" as="geometry"/></mxCell>
        <mxCell id="f6" value="下一次模型请求&#xa;重新执行整套解析&#xa;得到当时最新的能力清单" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontStyle=1;" vertex="1" parent="phase4"><mxGeometry x="1490" y="70" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="f7" value="双重范围检查&#xa;清单生成时先过滤一次&#xa;真正领取工具执行权前还会再次核对节点范围" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="1900" y="60" width="390" height="130" as="geometry"/></mxCell>
        <mxCell id="f8" value="本链路没有消息队列或后台任务&#xa;清单只在当前模型调用中有效" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="2350" y="70" width="390" height="110" as="geometry"/></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="可信身份" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s5" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d1" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="d4" target="d5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="d5" target="d6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="平台工具" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;strokeColor=#D79B00;" edge="1" parent="1" source="d6" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="满足" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="继续判断" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" value="不满足也继续" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="p2" target="p4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="1240"/><mxPoint x="1200" y="1240"/></Array></mxGeometry></mxCell>
        <mxCell id="e16" value="满足" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;" edge="1" parent="1" source="p6" target="p7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e19" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p6" target="p8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e20" value="最终清单" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;strokeColor=#67C9A3;" edge="1" parent="1" source="p7" target="f1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e21" value="最终清单" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;strokeColor=#67C9A3;" edge="1" parent="1" source="p8" target="f1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e22" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;" edge="1" parent="1" source="f1" target="f2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e23" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="f1" target="f3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e24" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="f3" target="f4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e25" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="f4" target="f5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e26" value="下一轮" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="f5" target="f6"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
