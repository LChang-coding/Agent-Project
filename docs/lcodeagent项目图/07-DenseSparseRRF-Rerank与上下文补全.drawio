        <mxCell id="c1" parent="phase3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" value="按 chunkId 合并两路命中&#xa;同一 ID 的文档、版本、索引版本&#xa;必须完全一致" vertex="1">
