          <mxGeometry height="90" width="290" x="730" y="80" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="phase3" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" value="回到 MySQL 批量读取完整分块&#xa;逐项核对租户、知识库、文档、版本和索引批次&#xa;不直接信任 Qdrant 负载" vertex="1">
