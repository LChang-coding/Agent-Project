        <mxCell id="c2" parent="phase3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" value="统一计算 0~1 分数&#xa;单路：原始分数转换&#xa;RRF：1/(60+rank) 后归一化&#xa;WEIGHTED：两路归一化后加权" vertex="1">
