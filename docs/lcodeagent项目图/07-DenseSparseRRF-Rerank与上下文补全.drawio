        <mxCell id="c8" parent="phase3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" value="是：前 rerankTopK + 原问题&#xa;交给 Rerank 服务&#xa;拒绝未知或重复 chunkId" vertex="1">
