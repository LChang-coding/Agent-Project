        <mxCell id="c5" parent="phase3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" value="去掉正在清理的旧记录&#xa;和 contentHash 相同的重复内容" vertex="1">
          <mxGeometry height="90" width="280" x="1460" y="80" as="geometry" />
        </mxCell>
        <mxCell id="c6" parent="phase3" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" value="启用 Rerank？" vertex="1">
          <mxGeometry height="100" width="210" x="1790" y="75" as="geometry" />
        </mxCell>
        <mxCell id="c7" parent="phase3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" value="否：按融合顺序&#xa;直接保留 finalTopK" vertex="1">
