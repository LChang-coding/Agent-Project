<mxfile host="Electron">
  <diagram id="agent-route" name="Agent提出路径服务端确定路径并执行下一个Agent">
    <mxGraphModel dx="2528" dy="1288" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3200" pageHeight="2300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F2937;" value="3. Agent 提出路径，服务端确定路径并执行下一个 Agent" vertex="1">
          <mxGeometry height="40" width="2200" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4B5563;" value="Agent 只能从当前节点的合法路径中提出建议；工具只登记，服务端固定规则检查后才推进 currentNodeId。" vertex="1">
          <mxGeometry height="30" width="2500" x="40" y="60" as="geometry" />
        </mxCell>
        <mxCell id="phase1" parent="1" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#F4F8FF;strokeColor=#6C8EBF;strokeWidth=2;" value="① 为当前 Agent 准备有限路径" vertex="1">
          <mxGeometry height="350" width="3100" x="40" y="110" as="geometry" />
        </mxCell>
        <mxCell id="r1" parent="phase1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" value="编译器读取当前节点全部出边" vertex="1">
          <mxGeometry height="80" width="260" x="30" y="80" as="geometry" />
        </mxCell>
        <mxCell id="r2" parent="phase1" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" value="把 routeKey、受控别名、edgeId、&#xa;targetNodeId 写入可信运行上下文" vertex="1">
          <mxGeometry height="100" width="300" x="350" y="70" as="geometry" />
        </mxCell>
        <mxCell id="r3" parent="phase1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" value="Tool Resolver 动态生成&#xa;routeKey 可选值范围" vertex="1">
          <mxGeometry height="80" width="260" x="710" y="80" as="geometry" />
        </mxCell>
        <mxCell id="r4" parent="phase1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;" value="Agent 只看到当前节点合法路径&#xa;看不到任意目标节点能力" vertex="1">
          <mxGeometry height="100" width="290" x="1030" y="70" as="geometry" />
        </mxCell>
        <mxCell id="r5" parent="phase1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" value="核心边界&#xa;自主路由是“有限路径内自主选择”&#xa;不是自由跳到画布外 Agent" vertex="1">
          <mxGeometry height="100" width="390" x="1450" y="70" as="geometry" />
        </mxCell>
        <mxCell id="r6" parent="phase1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" value="真实执行目标始终来自发布版本的&#xa;节点表和边表，再按 runtimeAgentId&#xa;找到已经装配的 Agent" vertex="1">
          <mxGeometry height="100" width="420" x="1900" y="70" as="geometry" />
        </mxCell>
        <mxCell id="phase2" parent="1" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#FAF7FF;strokeColor=#9673A6;strokeWidth=2;" value="② 路由工具只登记 Agent 的建议" vertex="1">
          <mxGeometry height="500" width="3100" x="40" y="490" as="geometry" />
        </mxCell>
        <mxCell id="t1" parent="phase2" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" value="Agent 可选择调用&#xa;select_workflow_route&#xa;只提交 routeKey + reason" vertex="1">
          <mxGeometry height="100" width="270" x="30" y="70" as="geometry" />
        </mxCell>
        <mxCell id="t2" parent="phase2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" value="Tool Gateway 补入可信字段&#xa;租户、用户、run、工作流版本、定义摘要、&#xa;nodeExecutionId、functionCallId、traceId" vertex="1">
          <mxGeometry height="120" width="330" x="350" y="60" as="geometry" />
        </mxCell>
        <mxCell id="t3" parent="phase2" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" value="检查运行仍可执行、协议为 TOOL_V2、&#xa;当前节点不是终点且合法出边完整" vertex="1">
          <mxGeometry height="120" width="290" x="730" y="60" as="geometry" />
        </mxCell>
        <mxCell id="t4" parent="phase2" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" value="routeKey 精确匹配&#xa;当前节点主键或受控别名？" vertex="1">
          <mxGeometry height="120" width="260" x="1070" y="60" as="geometry" />
        </mxCell>
        <mxCell id="t5" parent="phase2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" value="否：返回工具错误&#xa;不保存任何路径建议" vertex="1">
          <mxGeometry height="80" width="240" x="1080" y="250" as="geometry" />
        </mxCell>
        <mxCell id="t6" parent="phase2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" value="服务端解析真实 edgeId&#xa;和 targetNodeId&#xa;模型不能提交这两个字段" vertex="1">
          <mxGeometry height="100" width="270" x="1380" y="70" as="geometry" />
        </mxCell>
        <mxCell id="t7" parent="phase2" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" value="函数调用或当前节点&#xa;已经保存过建议？" vertex="1">
          <mxGeometry height="120" width="250" x="1700" y="60" as="geometry" />
        </mxCell>
        <mxCell id="t8" parent="phase2" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" value="首次：保存唯一 PENDING 建议&#xa;唯一范围为运行 + 节点执行编号&#xa;functionCallId 也只能对应一条记录" vertex="1">
          <mxGeometry height="120" width="310" x="2010" y="60" as="geometry" />
        </mxCell>
        <mxCell id="t9" parent="phase2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" value="重复请求&#xa;同一内容或同一边：返回第一次结果&#xa;改选另一边或范围变化：明确拒绝" vertex="1">
          <mxGeometry height="100" width="310" x="1700" y="250" as="geometry" />
        </mxCell>
        <mxCell id="t10" parent="phase2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;" value="只返回“路径建议已登记”&#xa;不修改 currentNodeId&#xa;不启动下一个 Agent" vertex="1">
          <mxGeometry height="120" width="310" x="2390" y="60" as="geometry" />
        </mxCell>
        <mxCell id="phase3" parent="1" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#FFF9F2;strokeColor=#D79B00;strokeWidth=2;" value="③ Agent 返回后：查询建议，缺少时只补选一次" vertex="1">
          <mxGeometry height="470" width="3100" x="40" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="q1" parent="phase3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;" value="当前 Agent 完成本轮输出&#xa;返回工作流协调线程" vertex="1">
          <mxGeometry height="90" width="280" x="30" y="70" as="geometry" />
        </mxCell>
        <mxCell id="q2" parent="phase3" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" value="按 tenantId + runId +&#xa;nodeExecutionId 查询 PENDING 建议" vertex="1">
          <mxGeometry height="90" width="290" x="360" y="70" as="geometry" />
        </mxCell>
        <mxCell id="q3" parent="phase3" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" value="TOOL_V2 非终点节点&#xa;没有提交建议？" vertex="1">
          <mxGeometry height="110" width="240" x="700" y="60" as="geometry" />
        </mxCell>
        <mxCell id="q4" parent="phase3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" value="只追加一次专门的补选请求&#xa;只开放路由工具&#xa;不重新执行原任务，不开放其他工具" vertex="1">
          <mxGeometry height="120" width="320" x="1000" y="60" as="geometry" />
        </mxCell>
        <mxCell id="q5" parent="phase3" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" value="补选结果" vertex="1">
          <mxGeometry height="110" width="210" x="1380" y="65" as="geometry" />
        </mxCell>
        <mxCell id="q6" parent="phase3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" value="成功：重新查询建议记录" vertex="1">
          <mxGeometry height="80" width="260" x="1650" y="40" as="geometry" />
        </mxCell>
        <mxCell id="q7" parent="phase3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" value="正常返回但仍无建议&#xa;后续只允许 DEFAULT&#xa;没有默认出口则明确失败" vertex="1">
          <mxGeometry height="100" width="280" x="1650" y="150" as="geometry" />
        </mxCell>
        <mxCell id="q8" parent="phase3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" value="补选发生技术异常&#xa;按 failed=true 尝试 FAILURE 出口&#xa;若指向普通节点仍可继续" vertex="1">
          <mxGeometry height="100" width="300" x="1650" y="280" as="geometry" />
        </mxCell>
        <mxCell id="q9" parent="phase3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;fontStyle=1;" value="无论是否有建议&#xa;都进入服务端固定规则选路&#xa;不会再次询问大模型" vertex="1">
          <mxGeometry height="110" width="310" x="2050" y="70" as="geometry" />
        </mxCell>
        <mxCell id="q10" parent="phase3" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" value="路由工具是可选分支&#xa;Agent 未调用时，主链路仍会经过补选和服务端选路" vertex="1">
          <mxGeometry height="100" width="390" x="2440" y="70" as="geometry" />
        </mxCell>
        <mxCell id="phase4" parent="1" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#F3FCF8;strokeColor=#67C9A3;strokeWidth=2;" value="④ 服务端固定规则选路、同事务推进并执行下一个 Agent" vertex="1">
          <mxGeometry height="600" width="3100" x="40" y="1520" as="geometry" />
        </mxCell>
        <mxCell id="d1" parent="phase4" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" value="先确认运行未取消&#xa;再检查总步数和 Token 上限" vertex="1">
          <mxGeometry height="120" width="270" x="30" y="60" as="geometry" />
        </mxCell>
        <mxCell id="d12" parent="phase4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" value="不允许继续&#xa;取消进入 CANCELLED 收尾&#xa;预算耗尽记录明确错误码并 FAILED" vertex="1">
          <mxGeometry height="110" width="270" x="30" y="250" as="geometry" />
        </mxCell>
        <mxCell id="d2" parent="phase4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" value="按固定策略顺序检查出边&#xa;FAILURE → FIXED → SUCCESS → EXPRESSION&#xa;→ NODE_SUGGESTION → AI_ROUTER → DEFAULT" vertex="1">
          <mxGeometry height="120" width="350" x="360" y="60" as="geometry" />
        </mxCell>
        <mxCell id="d3" parent="phase4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" value="同一策略多条边&#xa;priority 大的优先&#xa;相同 priority 按 edgeId 固定排序" vertex="1">
          <mxGeometry height="100" width="290" x="770" y="70" as="geometry" />
        </mxCell>
        <mxCell id="d4" parent="phase4" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" value="命中合法边？&#xa;目标必须属于 allowedTargetNodeIds&#xa;有建议时再核对工作流、摘要和 edgeId" vertex="1">
          <mxGeometry height="130" width="300" x="1120" y="55" as="geometry" />
        </mxCell>
        <mxCell id="d5" parent="phase4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" value="否：WORKFLOW_ROUTE_NOT_FOUND&#xa;运行明确失败" vertex="1">
          <mxGeometry height="80" width="260" x="1140" y="260" as="geometry" />
        </mxCell>
        <mxCell id="d6" parent="phase4" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" value="同一数据库事务完成&#xa;存在建议时 PENDING → CONSUMED&#xa;保存最终路径和原因、节点审计 COMPLETED&#xa;currentNodeId → 目标节点" vertex="1">
          <mxGeometry height="140" width="350" x="1480" y="50" as="geometry" />
        </mxCell>
        <mxCell id="d7" parent="phase4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" value="事务成功后才更新&#xa;协调线程内的 currentNodeId&#xa;避免数据库与内存只成功一边" vertex="1">
          <mxGeometry height="100" width="300" x="1890" y="70" as="geometry" />
        </mxCell>
        <mxCell id="d8" parent="phase4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" value="下一轮 nodes.get(currentNodeId)&#xa;读取目标节点 runtimeAgentId&#xa;执行对应的下一个 Agent" vertex="1">
          <mxGeometry height="120" width="330" x="2250" y="60" as="geometry" />
        </mxCell>
        <mxCell id="d9" parent="phase4" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" value="失败边界&#xa;Agent 重试耗尽先尝试当前节点 FAILURE 出口&#xa;只有出口到 END 或无出口时才最终失败" vertex="1">
          <mxGeometry height="110" width="480" x="360" y="280" as="geometry" />
        </mxCell>
        <mxCell id="d10" parent="phase4" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" value="兼容边界&#xa;Router 仍保留 FIXED、SUCCESS 和表达式等旧策略&#xa;不能把新协议描述成只按 routeKey 选路" vertex="1">
          <mxGeometry height="110" width="470" x="1480" y="280" as="geometry" />
