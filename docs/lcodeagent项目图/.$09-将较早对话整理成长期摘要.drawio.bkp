<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="31.0.2">
  <diagram id="conversation-compaction" name="将较早对话整理成长期摘要">
    <mxGraphModel dx="3000" dy="2000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3200" pageHeight="2500" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="9. 将较早对话整理成长期摘要" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1700" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="本图范围：达到阈值后登记摘要任务 → Kafka 通知后台处理 → 多次核对避免旧结果覆盖新对话 → 短事务启用新摘要 → Redis 更新 → 工具执行前的紧急整理和有限重试。" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="2850" height="30" as="geometry"/></mxCell>

        <mxCell id="phase1" value="① 助手回答保存后，判断是否需要整理较早历史" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#F4F8FF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="3100" height="390" as="geometry"/></mxCell>
        <mxCell id="a1" value="助手回答先保存到 MySQL" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="30" y="80" width="250" height="85" as="geometry"/></mxCell>
        <mxCell id="a2" value="读取当前长期摘要&#xa;已经覆盖到的消息序号" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="330" y="75" width="260" height="95" as="geometry"/></mxCell>
        <mxCell id="a3" value="统计尚未整理的有效消息 Token&#xa;直到本次助手回答" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="640" y="75" width="280" height="95" as="geometry"/></mxCell>
        <mxCell id="a4" value="达到 12000 Token？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="970" y="70" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="a5" value="未达到：本轮不创建任务&#xa;继续保留原始历史" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="960" y="225" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="a6" value="达到：从最新消息向前&#xa;保留约 4096 Token 原文&#xa;较早连续区间进入本次整理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="1250" y="70" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="a7" value="对消息编号、有效状态、正文和附件&#xa;计算 SHA-256&#xa;用于发现整理期间输入是否变化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="phase1"><mxGeometry x="1610" y="70" width="320" height="105" as="geometry"/></mxCell>
        <mxCell id="a8" value="根据会话、消息范围、摘要版本&#xa;上下文版本、内容摘要和策略版本&#xa;生成稳定任务键" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="phase1"><mxGeometry x="1990" y="70" width="320" height="105" as="geometry"/></mxCell>
        <mxCell id="a9" value="先在 MySQL 创建 PENDING 任务&#xa;相同任务键再次创建时返回原任务&#xa;不重复生成摘要" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="phase1"><mxGeometry x="2370" y="65" width="330" height="115" as="geometry"/></mxCell>
        <mxCell id="a10" value="任务先保存，通知后发送&#xa;MySQL 保存最终处理状态" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" vertex="1" parent="phase1"><mxGeometry x="2760" y="75" width="270" height="95" as="geometry"/></mxCell>

        <mxCell id="phase2" value="② Kafka 只负责通知；发送失败时由数据库任务继续兜底" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#FFF9F2;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="3100" height="360" as="geometry"/></mxCell>
        <mxCell id="b1" value="向 context.compaction.request.v1&#xa;发送任务编号和 Trace 信息&#xa;分区键 tenantId:sessionId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="phase2"><mxGeometry x="30" y="75" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="b2" value="等待 Kafka 确认&#xa;默认最多 3000ms" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="390" y="75" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="b3" value="确认成功：消费者会尽快收到通知" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="670" y="45" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="b4" value="失败 / 超时 / 中断：明确报错&#xa;但不推翻已经保存成功的助手回答&#xa;MySQL 任务仍保留" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="phase2"><mxGeometry x="670" y="155" width="310" height="100" as="geometry"/></mxCell>
        <mxCell id="b5" value="同一会话再次产生回答时&#xa;顺手重新通知该会话未完成任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="1050" y="75" width="290" height="100" as="geometry"/></mxCell>
        <mxCell id="b6" value="全局定时扫描&#xa;查找等待处理、等待再次尝试&#xa;和处理超时的任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="1400" y="75" width="290" height="100" as="geometry"/></mxCell>
        <mxCell id="b7" value="逐条重新发送通知&#xa;某一条失败不会阻止同批其他任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="1750" y="80" width="290" height="90" as="geometry"/></mxCell>
        <mxCell id="b8" value="部署边界&#xa;Kafka 开发配置默认关闭&#xa;部署时需显式开启 listener、主 topic、重试 topic 和 DLT" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="phase2"><mxGeometry x="2120" y="65" width="380" height="115" as="geometry"/></mxCell>
        <mxCell id="b9" value="Kafka 是加速通知通道&#xa;不是任务是否完成的判断来源" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" vertex="1" parent="phase2"><mxGeometry x="2600" y="75" width="330" height="100" as="geometry"/></mxCell>

        <mxCell id="phase3" value="③ 消费者领取任务，生成摘要前后都重新核对输入" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#FAF7FF;strokeColor=#9673A6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="3100" height="470" as="geometry"/></mxCell>
        <mxCell id="c1" value="消费者从消息恢复&#xa;租户、用户和原始 Trace ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="30" y="80" width="270" height="95" as="geometry"/></mxCell>
        <mxCell id="c2" value="用 MySQL 条件更新领取任务&#xa;成功后 attemptCount + 1&#xa;取得 60 秒执行期限和本次执行编号" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="phase3"><mxGeometry x="350" y="70" width="320" height="115" as="geometry"/></mxCell>
        <mxCell id="c3" value="领取成功？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="730" y="75" width="200" height="105" as="geometry"/></mxCell>
        <mxCell id="c4" value="否：任务已完成、取消&#xa;或被其他实例处理&#xa;本次通知直接结束" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="720" y="245" width="230" height="95" as="geometry"/></mxCell>
        <mxCell id="c5" value="重新读取当前摘要、上下文版本&#xa;待整理消息和附件&#xa;并重新计算内容摘要" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="990" y="70" width="310" height="115" as="geometry"/></mxCell>
        <mxCell id="c6" value="与任务创建时保存的版本和 SHA-256 一致？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="phase3"><mxGeometry x="1360" y="70" width="290" height="115" as="geometry"/></mxCell>
        <mxCell id="c7" value="另一任务已覆盖：直接完成&#xa;消息失效或内容变化：拒绝旧输入&#xa;不调用摘要模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="phase3"><mxGeometry x="1350" y="245" width="310" height="100" as="geometry"/></mxCell>
        <mxCell id="c8" value="根据会话 Agent 找到模型&#xa;输入旧摘要、待整理消息、附件&#xa;和明确 JSON 输出格式" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="1710" y="70" width="310" height="115" as="geometry"/></mxCell>
        <mxCell id="c9" value="模型返回结构化内容&#xa;conversationSummary / decisions&#xa;constraints / openItems / keyEntities" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="phase3"><mxGeometry x="2080" y="70" width="310" height="115" as="geometry"/></mxCell>
        <mxCell id="c10" value="服务端校验字段&#xa;消息起止范围由服务端填写&#xa;不采用模型自报的范围" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="2450" y="75" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="c11" value="模型请求结束后再次核对&#xa;任务状态 / 上下文版本 / 本次执行编号&#xa;旧执行者不能提交迟到结果" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="phase3"><mxGeometry x="2790" y="65" width="270" height="125" as="geometry"/></mxCell>

        <mxCell id="phase4" value="④ 用短事务启用新摘要，提交成功后再更新 Redis" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#F3FCF8;strokeColor=#67C9A3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1420" width="3100" height="390" as="geometry"/></mxCell>
        <mxCell id="d1" value="进入短数据库事务&#xa;耗时的模型请求已经在事务外完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="30" y="80" width="290" height="95" as="geometry"/></mxCell>
        <mxCell id="d2" value="锁定会话并最后一次确认&#xa;消息、附件和上下文版本没有变化" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="370" y="75" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="d3" value="保存新摘要&#xa;旧摘要改为不再使用" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="720" y="80" width="250" height="95" as="geometry"/></mxCell>
        <mxCell id="d4" value="任务改为 SUCCEEDED&#xa;会话 contextRevision + 1" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="1020" y="80" width="260" height="95" as="geometry"/></mxCell>
        <mxCell id="d5" value="事务全部成功提交？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="1330" y="75" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="d6" value="失败：整组数据库修改回滚&#xa;不会出现摘要已换但任务未完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="1320" y="230" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="d7" value="提交成功后更新 Redis 摘要&#xa;删除已经进入摘要的近期消息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="1610" y="75" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="d8" value="后续模型上下文变为&#xa;新长期摘要 + 尚未覆盖的近期消息" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" vertex="1" parent="phase4"><mxGeometry x="1970" y="75" width="310" height="105" as="geometry"/></mxCell>
        <mxCell id="d9" value="Redis 更新失败不影响 MySQL 新摘要&#xa;下次读取时会从 MySQL 恢复缓存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="2340" y="80" width="310" height="95" as="geometry"/></mxCell>

        <mxCell id="phase5" value="⑤ 失败重试、工具执行前紧急整理与能力边界" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#FFF7F7;strokeColor=#B85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1840" width="3100" height="560" as="geometry"/></mxCell>
        <mxCell id="f1" value="后台处理失败&#xa;先把稳定错误原因写回 MySQL" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="phase5"><mxGeometry x="30" y="75" width="280" height="95" as="geometry"/></mxCell>
        <mxCell id="f2" value="尝试次数少于 3？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase5"><mxGeometry x="370" y="70" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="f3" value="是：状态改为 RETRYING&#xa;重试主题延迟 1000ms 再通知" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="phase5"><mxGeometry x="650" y="45" width="290" height="85" as="geometry"/></mxCell>
        <mxCell id="f4" value="否：状态改为 DEAD&#xa;或进入 DLT 后保留错误供排查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="phase5"><mxGeometry x="650" y="160" width="290" height="85" as="geometry"/></mxCell>
        <mxCell id="f5" value="模型已经决定调用工具&#xa;真正执行前发现历史超过阈值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="phase5"><mxGeometry x="1020" y="75" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="f6" value="当前线程创建或找到同范围任务&#xa;自己领取成功就立即整理&#xa;否则最多等待另一执行者 5 秒" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="phase5"><mxGeometry x="1380" y="65" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="f7" value="新摘要成功启用&#xa;contextRevision 已变化&#xa;旧背景生成的工具参数不得继续执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="phase5"><mxGeometry x="1760" y="45" width="310" height="105" as="geometry"/></mxCell>
        <mxCell id="f8" value="要求 Agent 基于新背景&#xa;重新判断是否调用工具以及使用什么参数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="phase5"><mxGeometry x="2130" y="55" width="310" height="95" as="geometry"/></mxCell>
        <mxCell id="f9" value="等待超时或整理失败&#xa;工具不在旧背景下继续执行&#xa;当前调用明确失败" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="phase5"><mxGeometry x="1760" y="185" width="310" height="100" as="geometry"/></mxCell>
        <mxCell id="f10" value="能力边界&#xa;同步整理只发生在真正执行工具之前&#xa;普通模型调用前不会主动同步整理" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="phase5"><mxGeometry x="2510" y="55" width="390" height="110" as="geometry"/></mxCell>
        <mxCell id="f11" value="等待间隔从 50ms 逐步增加&#xa;最大 1000ms，避免持续高频查库" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="phase5"><mxGeometry x="1380" y="250" width="320" height="85" as="geometry"/></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="a4" target="a6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a6" target="a7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a7" target="a8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a8" target="a9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a9" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell>
