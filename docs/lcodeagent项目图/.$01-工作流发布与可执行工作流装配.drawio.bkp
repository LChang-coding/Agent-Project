<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="31.0.2">
  <diagram id="publish-runtime" name="工作流发布与可执行工作流装配">
    <mxGraphModel dx="3000" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3200" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="1. 工作流发布与可执行工作流装配" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1800" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="发布只固定可运行版本；第一次启动该版本时才编译执行计划、装配各节点 Agent，并写入当前实例内存缓存。" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4B5563;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="2500" height="30" as="geometry"/></mxCell>

        <mxCell id="phase1" value="① 发布请求与事务校验" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#F4F8FF;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="3100" height="430" as="geometry"/></mxCell>
        <mxCell id="p1" value="用户在画布点击发布&#xa;POST /workflows/{workflowId}/publish" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="30" y="70" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="p2" value="Controller 从登录上下文取得&#xa;租户、用户和角色&#xa;不接受请求伪造身份" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="350" y="70" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="p3" value="查询工作流和最新草稿&#xa;检查当前用户是否有修改权限" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="660" y="70" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="p4" value="草稿、节点、边、入口节点、&#xa;路由设置和基础参数都合法？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="970" y="60" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="p5" value="否：拒绝发布并回滚事务&#xa;旧的已发布版本不受影响" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="980" y="230" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="p6" value="草稿版本 DRAFT → PUBLISHED&#xa;记录发布人和发布时间" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="1280" y="70" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="p7" value="工作流主记录的 publishedVersion&#xa;指向刚发布的版本" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="1590" y="70" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="p8" value="事务提交后清除当前实例中&#xa;该工作流的旧装配缓存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="1900" y="70" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="p9" value="返回已发布版本和画布内容&#xa;发布阶段没有后台装配任务" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="2220" y="70" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="p10" value="关键边界&#xa;发布成功不等于 Runtime 已注册&#xa;Agent 装配发生在第一次启动时" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="phase1"><mxGeometry x="2590" y="60" width="380" height="110" as="geometry"/></mxCell>

        <mxCell id="phase2" value="② 第一次启动时选择版本、模型和缓存" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#FAF7FF;strokeColor=#9673A6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="3100" height="400" as="geometry"/></mxCell>
        <mxCell id="l1" value="用户第一次启动某个发布版本&#xa;调用 loadRuntime" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="30" y="70" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="l2" value="选择版本&#xa;未指定：最新发布版本&#xa;已指定：该版本必须已发布" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="340" y="70" width="270" height="100" as="geometry"/></mxCell>
        <mxCell id="l3" value="版本状态是 PUBLISHED？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="660" y="65" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="l4" value="否：拒绝启动&#xa;草稿或不存在版本不能运行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="650" y="230" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="l5" value="确定实际模型&#xa;请求指定模型 &gt; 节点模型&#xa;&gt; 工作流默认模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="940" y="70" width="270" height="100" as="geometry"/></mxCell>
        <mxCell id="l6" value="当前实例缓存键&#xa;tenantId + workflowId + version&#xa;+ modelCode" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="1260" y="70" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="l7" value="已有完整装配缓存？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="1590" y="65" width="220" height="110" as="geometry"/></mxCell>
        <mxCell id="l8" value="是：直接复用执行计划&#xa;和已经装配好的节点 Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="1870" y="40" width="270" height="90" as="geometry"/></mxCell>
        <mxCell id="l9" value="否：进入首次编译与装配" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=13;fontStyle=1;" vertex="1" parent="phase2"><mxGeometry x="1870" y="180" width="270" height="80" as="geometry"/></mxCell>
        <mxCell id="l11" value="返回缓存中的完整 Runtime&#xa;无需再次编译和装配" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" vertex="1" parent="phase2"><mxGeometry x="2200" y="35" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="l10" value="缓存边界&#xa;只在当前 Java 进程内，不是 Redis&#xa;不同实例会各自装配一次" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="phase2"><mxGeometry x="2600" y="70" width="390" height="100" as="geometry"/></mxCell>

        <mxCell id="phase3" value="③ 编译发布版本为受控执行计划" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#FFF9F2;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="3100" height="430" as="geometry"/></mxCell>
        <mxCell id="c1" value="编译器重新检查&#xa;工作流类型和图结构" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="30" y="70" width="250" height="90" as="geometry"/></mxCell>
        <mxCell id="c2" value="图类型与环路合法？&#xa;普通工作流禁止环路&#xa;智能工作流允许受控回路" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="330" y="60" width="250" height="120" as="geometry"/></mxCell>
        <mxCell id="c3" value="否：第一次启动失败&#xa;不进入 Agent 装配" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="340" y="250" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="c4" value="为每个 LLM 节点生成&#xa;独立内部 Agent ID、模型配置、&#xa;指令和 Runner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="640" y="70" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="c5" value="把画布边编译成当前节点的&#xa;合法出口和目标范围&#xa;不能跳到画布外节点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="970" y="70" width="290" height="100" as="geometry"/></mxCell>
        <mxCell id="c6" value="固定执行约束&#xa;根节点、路由协议、maxSteps、Token 上限&#xa;allowedTargetNodeIds、maxVisits" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="1310" y="70" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="c7" value="计算整份执行计划的&#xa;SHA-256 定义摘要&#xa;供运行和工具调用核对版本" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="1680" y="70" width="290" height="100" as="geometry"/></mxCell>
        <mxCell id="c8" value="目标设计与代码边界&#xa;发布校验和首次编译校验分处两阶段&#xa;若规则不一致，可能发布成功但首次启动失败" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase3"><mxGeometry x="2100" y="60" width="480" height="120" as="geometry"/></mxCell>

        <mxCell id="phase4" value="④ 全量装配、原子写缓存与返回 Runtime" style="swimlane;startSize=36;container=1;pointerEvents=0;rounded=1;arcSize=6;html=1;fontSize=17;fontStyle=1;fillColor=#F3FCF8;strokeColor=#67C9A3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1460" width="3100" height="440" as="geometry"/></mxCell>
        <mxCell id="a1" value="Armory 装配全部节点 Agent&#xa;逐个注册模型、指令和 Runner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;fontStyle=1;" vertex="1" parent="phase4"><mxGeometry x="30" y="70" width="290" height="100" as="geometry"/></mxCell>
        <mxCell id="a2" value="全部节点装配成功？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="380" y="65" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="a3" value="否：本次启动失败&#xa;不把半成品写入缓存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="380" y="240" width="230" height="80" as="geometry"/></mxCell>
        <mxCell id="a4" value="是：完整 Runtime 写入&#xa;当前应用实例内存缓存" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="680" y="70" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="a5" value="返回可直接执行的工作流&#xa;已装配 Agent + 节点配置&#xa;+ 合法出边 + 定义摘要" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;fontStyle=1;" vertex="1" parent="phase4"><mxGeometry x="1020" y="60" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="a6" value="版本隔离&#xa;新草稿使用新版本号&#xa;不会修改已经发布或正在运行的版本" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="1450" y="70" width="350" height="100" as="geometry"/></mxCell>
        <mxCell id="a7" value="模型隔离&#xa;同一工作流版本使用不同请求模型时&#xa;缓存键不同，不会复用错误 Runner" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="1860" y="70" width="390" height="100" as="geometry"/></mxCell>
        <mxCell id="a8" value="多实例边界&#xa;每个实例各自装配与缓存&#xa;不能描述成全局只装配一次" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="phase4"><mxGeometry x="2310" y="70" width="390" height="100" as="geometry"/></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p4" target="p6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="p6" target="p7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="p7" target="p8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="p8" target="p9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="之后首次启动" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;strokeColor=#9673A6;" edge="1" parent="1" source="p9" target="l1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2400" y="550"/><mxPoint x="200" y="550"/></Array></mxGeometry></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="l2" target="l3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;" edge="1" parent="1" source="l3" target="l4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="l3" target="l5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="l5" target="l6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="l6" target="l7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" value="有" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="l7" target="l8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" value="无" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;strokeColor=#D79B00;" edge="1" parent="1" source="l7" target="l9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e30" value="直接返回" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;strokeColor=#82B366;" edge="1" parent="1" source="l8" target="l11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" value="首次编译" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;strokeColor=#D79B00;" edge="1" parent="1" source="l9" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e19" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e20" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e21" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e24" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e25" value="完整计划" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;strokeColor=#9673A6;" edge="1" parent="1" source="c7" target="a1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e26" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e27" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;strokeColor=#B85450;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e28" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="a2" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e29" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
