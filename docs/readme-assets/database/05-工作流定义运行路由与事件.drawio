<?xml version='1.0' encoding='UTF-8'?>
<mxfile host="Electron" modified="2026-08-14T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="overview-05" name="01-领域总览与表职责">
    <mxGraphModel dx="2500" dy="1175" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1175" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="工作流定义、运行、路由与事件：表职责与业务链路" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=30;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="44" y="20" width="2412" height="44" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="冻结可视化工作流版本，记录节点执行、路由意图、权威裁决、外部调用、恢复任务和可重放事件。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="46" y="68" width="2408" height="38" as="geometry" />
        </mxCell>
        <mxCell id="flows" value="&lt;div style='text-align:left;line-height:1.65'&gt;&lt;b style='font-size:18px'&gt;核心业务链路&lt;/b&gt;&lt;br&gt;定义链：agent_workflow → agent_workflow_version&lt;br&gt;运行链：chat_run → intelligent_workflow_run → workflow_node_execution&lt;br&gt;路由链：workflow_route_intent → workflow_route_decision → current_node_id&lt;br&gt;可靠性链：workflow_execution_task / workflow_invocation / workflow_outbox&lt;br&gt;前端事件链：workflow_run_event_cursor → workflow_run_event → SSE 游标回放&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9fafb;strokeColor=#6b7280;fontSize=15;align=left;verticalAlign=middle;spacing=14;dashed=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="120" width="2390" height="160" as="geometry" />
        </mxCell>
        <mxCell id="purpose_agent_workflow" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;agent_workflow&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;工作流稳定主记录，保存当前版本、发布状态和删除审计。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;可视化工作流编辑器后端&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;工作流目录和 Runtime Loader&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;draft 编辑 → published；可 disabled/deleted&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="310" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_agent_workflow_version" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;agent_workflow_version&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;冻结每次发布的工作流图、节点配置、路由协议和模型参数。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;工作流发布服务&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;普通/智能工作流编译器和历史 Run 回放&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;版本只追加；draft → published，不覆盖历史版本&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="870" y="310" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_intelligent_workflow_run" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;intelligent_workflow_run&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;保存智能工作流当前节点、变量、步数、Token 预算和 revision。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;IntelligentWorkflowRuntimeService&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;恢复任务、状态查询和事件发布&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;RUNNING → COMPLETED/FAILED/CANCELLED；每次推进 revision + 1&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1685" y="310" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_workflow_node_execution" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;workflow_node_execution&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;记录一个节点在某 Run 中的第几次执行、输出、Token 和错误。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;工作流节点运行时&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;前端节点面板、路由裁决和调用审计&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;RUNNING → COMPLETED/FAILED/CANCELLED；循环节点按 execution_index 区分&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="515" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_workflow_route_intent" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;workflow_route_intent&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;保存 Agent 调用 select_workflow_route 后的受控路由意图，但不直接推进节点。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;WorkflowRoutePlatformToolHandler&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;IntelligentWorkflowRuntimeService&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;PENDING → CONSUMED；定义变化/取消时 REJECTED/CANCELLED&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="870" y="515" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_workflow_route_decision" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;workflow_route_decision&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;保存运行时校验后接受的权威边和目标节点，是前端与推进逻辑的真相源。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;智能工作流路由运行时&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;节点推进、事件发布和前端路由展示&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;每个 node_execution 只允许一条最终裁决&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1685" y="515" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_workflow_run_event" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;workflow_run_event&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;按严格 sequence 保存节点、工具、路由、输出和终态事件，支持断线重放。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;工作流事件发布服务&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;SSE 追尾服务和前端 reducer&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;追加写；到 expires_at 后可清理；终态事件结束追尾&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="720" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_workflow_run_event_cursor" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;workflow_run_event_cursor&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;为每个 Run 原子分配下一事件序号并记录唯一终态槽位。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;工作流事件仓储&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;所有事件发布路径&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;next_sequence 单调递增；terminal_sequence 只能首次写入&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="870" y="720" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_workflow_execution_task" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;workflow_execution_task&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;保存可恢复节点执行任务的租约、重试时间、fencing 和 revision。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;工作流运行协调器&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;执行 Worker 与恢复扫描器&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;READY/RUNNING/RETRYING → COMPLETED；失败 FAILED/DEAD&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1685" y="720" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_workflow_invocation" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;workflow_invocation&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;记录节点对模型、工具或平台能力的外部调用及其重放安全级别。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;WorkflowInvocationGuardService&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;崩溃恢复、幂等判断和审计&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;RUNNING → SUCCEEDED/FAILED/CANCELLED；idempotency_key 唯一&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="925" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_workflow_outbox" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;workflow_outbox&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;可靠发布工作流运行事件或恢复事件，避免业务状态与消息双写丢失。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;工作流状态事务&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;Workflow Outbox Publisher&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;PENDING/PUBLISHING → PUBLISHED；失败 RETRYING/DEAD&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="870" y="925" width="760" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="detail-05-2" name="02-agent_workflow + agent_workflow_version">
    <mxGraphModel dx="2420" dy="1408" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="1408" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="工作流定义、运行、路由与事件：字段明细" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=30;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="44" y="20" width="2332" height="44" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="每页只展示 1–2 张表；先解释业务职责，再列完整字段、状态枚举、主键、唯一键和索引。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="46" y="68" width="2328" height="38" as="geometry" />
        </mxCell>
        <mxCell id="purpose_agent_workflow" value="&lt;div style='text-align:left;line-height:1.55'&gt;&lt;b style='font-size:20px'&gt;agent_workflow&lt;/b&gt;&lt;br&gt;&lt;b&gt;这张表解决什么：&lt;/b&gt;工作流稳定主记录，保存当前版本、发布状态和删除审计。&lt;br&gt;&lt;b&gt;谁写入：&lt;/b&gt;可视化工作流编辑器后端　　&lt;b&gt;谁读取：&lt;/b&gt;工作流目录和 Runtime Loader&lt;br&gt;&lt;b&gt;关键生命周期：&lt;/b&gt;draft 编辑 → published；可 disabled/deleted&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;align=left;verticalAlign=middle;spacing=16;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="125" width="1120" height="150" as="geometry" />
        </mxCell>
        <mxCell id="table_agent_workflow" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;b style='font-size:21px'&gt;agent_workflow&lt;/b&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;agent_workflow&lt;/span&gt;&lt;hr&gt;&lt;b&gt;字段&lt;/b&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[PK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主键（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;tenant_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租户业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;owner_user_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　工作流拥有者用户ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;visibility&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　可见范围：private/tenant_public（NOT NULL，默认 &amp;#x27;private&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;workflow_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　工作流业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;workflow_name&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　工作流名称（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;description&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(512)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　工作流描述（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;status&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　工作流状态：draft/published/disabled/archived；draft=草稿；published=已发布；disabled=停用（NOT NULL，默认 &amp;#x27;draft&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;default_model_code&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　默认模型编码（NOT NULL，默认 &amp;#x27;deepseek-v4-flash&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;current_version&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　当前草稿版本（NOT NULL，默认 1）&lt;/span&gt;&lt;br&gt;&lt;b&gt;published_version&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　当前发布版本，0表示未发布（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;deleted_by&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　执行工作流删除的用户标识（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;deleted_at&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　工作流删除时间（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;metadata&lt;/b&gt; &lt;span style='color:#2563eb'&gt;JSON NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　扩展信息（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;create_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　创建时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;update_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　更新时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;deleted&lt;/b&gt; &lt;span style='color:#2563eb'&gt;TINYINT(1)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　删除标记，0未删除，1已删除（NOT NULL，默认 0）&lt;/span&gt;&lt;hr&gt;&lt;b&gt;约束与索引&lt;/b&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;PK(id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_agent_workflow_tenant_workflow(tenant_id, workflow_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_agent_workflow_owner(owner_user_id, create_time)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_agent_workflow_tenant_status(tenant_id, status, update_time)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=14;align=left;verticalAlign=top;spacing=18;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="55" y="305" width="1120" height="1008" as="geometry" />
        </mxCell>
        <mxCell id="purpose_agent_workflow_version" value="&lt;div style='text-align:left;line-height:1.55'&gt;&lt;b style='font-size:20px'&gt;agent_workflow_version&lt;/b&gt;&lt;br&gt;&lt;b&gt;这张表解决什么：&lt;/b&gt;冻结每次发布的工作流图、节点配置、路由协议和模型参数。&lt;br&gt;&lt;b&gt;谁写入：&lt;/b&gt;工作流发布服务　　&lt;b&gt;谁读取：&lt;/b&gt;普通/智能工作流编译器和历史 Run 回放&lt;br&gt;&lt;b&gt;关键生命周期：&lt;/b&gt;版本只追加；draft → published，不覆盖历史版本&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;align=left;verticalAlign=middle;spacing=16;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1245" y="125" width="1120" height="150" as="geometry" />
        </mxCell>
        <mxCell id="table_agent_workflow_version" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;b style='font-size:21px'&gt;agent_workflow_version&lt;/b&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;agent_workflow_version&lt;/span&gt;&lt;hr&gt;&lt;b&gt;字段&lt;/b&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[PK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主键（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;tenant_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租户业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;workflow_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK] [REF]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　工作流业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;version&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　版本号（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;version_status&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　版本状态：draft/published/archived；draft=草稿；published=冻结发布（NOT NULL，默认 &amp;#x27;draft&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;default_model_code&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　默认模型编码（NOT NULL，默认 &amp;#x27;deepseek-v4-flash&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;graph_json&lt;/b&gt; &lt;span style='color:#2563eb'&gt;LONGTEXT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　画布图结构 JSON（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;created_by&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　创建者用户ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;published_by&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　发布者用户ID（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;published_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　发布时间（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;metadata&lt;/b&gt; &lt;span style='color:#2563eb'&gt;JSON NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　扩展信息（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;create_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　创建时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;update_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　更新时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;deleted&lt;/b&gt; &lt;span style='color:#2563eb'&gt;TINYINT(1)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　删除标记，0未删除，1已删除（NOT NULL，默认 0）&lt;/span&gt;&lt;hr&gt;&lt;b&gt;约束与索引&lt;/b&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;PK(id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_agent_workflow_version(tenant_id, workflow_id, version)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_agent_workflow_version_status(tenant_id, workflow_id, version_status, version)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=14;align=left;verticalAlign=top;spacing=18;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1245" y="305" width="1120" height="854" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="detail-05-3" name="03-intelligent_workflow_run + workflow_node_execution">
