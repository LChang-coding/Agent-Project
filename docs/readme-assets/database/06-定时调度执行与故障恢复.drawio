  <diagram id="detail-06-3" name="03-agent_schedule_execution">
    <mxGraphModel dx="1230" dy="1716" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1230" pageHeight="1716" math="0" shadow="0">
      <root>
        <mxCell id="0" />
