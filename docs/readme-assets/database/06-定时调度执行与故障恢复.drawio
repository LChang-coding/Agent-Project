<?xml version='1.0' encoding='UTF-8'?>
<mxfile host="Electron" modified="2026-08-14T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="overview-06" name="01-领域总览与表职责">
    <mxGraphModel dx="2500" dy="560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="定时调度、执行与故障恢复：表职责与业务链路" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=30;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="44" y="20" width="2412" height="44" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="把用户 Cron 配置收敛为可领取的调度任务，并为每个计划触发点生成幂等执行记录。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="46" y="68" width="2408" height="38" as="geometry" />
        </mxCell>
        <mxCell id="flows" value="&lt;div style='text-align:left;line-height:1.65'&gt;&lt;b style='font-size:18px'&gt;核心业务链路&lt;/b&gt;&lt;br&gt;配置链：agent_schedule_config → agent_schedule_task&lt;br&gt;触发链：到达 next_fire_time → Worker Lease → agent_schedule_execution → Agent/Workflow Run&lt;br&gt;恢复链：心跳续租；租约过期重新领取；trigger_key 阻止同一触发点重复执行&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9fafb;strokeColor=#6b7280;fontSize=15;align=left;verticalAlign=middle;spacing=14;dashed=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="120" width="2390" height="160" as="geometry" />
        </mxCell>
        <mxCell id="purpose_agent_schedule_config" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;agent_schedule_config&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;保存用户配置的 Cron、目标 Agent/工作流、任务参数和执行身份。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;定时任务管理接口&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;调度配置对账器&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;enabled/disabled；config_version 变化后重新收敛任务&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="310" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_agent_schedule_task" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;agent_schedule_task&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;保存调度器实际执行的配置快照、下次触发时间、Lease 和重试状态。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;调度配置 Reconciler&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;定时扫描器和调度 Worker&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;ready → running → ready；失败 retry；停用 disabled；租约过期可接管&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="870" y="310" width="760" height="170" as="geometry" />
        </mxCell>
        <mxCell id="purpose_agent_schedule_execution" value="&lt;div style='text-align:left;line-height:1.5'&gt;&lt;b style='font-size:18px'&gt;agent_schedule_execution&lt;/b&gt;&lt;br&gt;&lt;b&gt;用途：&lt;/b&gt;保存某一 planned_time 的实际执行结果，trigger_key 防止重复触发。&lt;br&gt;&lt;b&gt;写入：&lt;/b&gt;调度 Worker&lt;br&gt;&lt;b&gt;读取：&lt;/b&gt;任务历史、重试判断和运维审计&lt;br&gt;&lt;b&gt;生命周期：&lt;/b&gt;running → success/failed/cancelled；每个 trigger_key 唯一&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1685" y="310" width="760" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="detail-06-2" name="02-agent_schedule_config + agent_schedule_task">
    <mxGraphModel dx="2420" dy="1892" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="1892" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="定时调度、执行与故障恢复：字段明细" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=30;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="44" y="20" width="2332" height="44" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="每页只展示 1–2 张表；先解释业务职责，再列完整字段、状态枚举、主键、唯一键和索引。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="46" y="68" width="2328" height="38" as="geometry" />
        </mxCell>
        <mxCell id="purpose_agent_schedule_config" value="&lt;div style='text-align:left;line-height:1.55'&gt;&lt;b style='font-size:20px'&gt;agent_schedule_config&lt;/b&gt;&lt;br&gt;&lt;b&gt;这张表解决什么：&lt;/b&gt;保存用户配置的 Cron、目标 Agent/工作流、任务参数和执行身份。&lt;br&gt;&lt;b&gt;谁写入：&lt;/b&gt;定时任务管理接口　　&lt;b&gt;谁读取：&lt;/b&gt;调度配置对账器&lt;br&gt;&lt;b&gt;关键生命周期：&lt;/b&gt;enabled/disabled；config_version 变化后重新收敛任务&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;align=left;verticalAlign=middle;spacing=16;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="125" width="1120" height="150" as="geometry" />
        </mxCell>
        <mxCell id="table_agent_schedule_config" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;b style='font-size:21px'&gt;agent_schedule_config&lt;/b&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;agent_schedule_config&lt;/span&gt;&lt;hr&gt;&lt;b&gt;字段&lt;/b&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[PK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主键（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;tenant_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租户业务ID，个体户可为空（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;owner_user_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　配置拥有者用户ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;run_as_user_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　任务执行身份用户ID，用于上下文、权限和用量归属（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;visibility&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　可见范围：private/tenant_public（NOT NULL，默认 &amp;#x27;private&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;config_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　调度配置业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;agent_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　Agent ID（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;agent_name&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　Agent 名称（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;cron_expr&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　Cron 表达式（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;timezone&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　时区（NOT NULL，默认 &amp;#x27;Asia/Shanghai&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;enabled&lt;/b&gt; &lt;span style='color:#2563eb'&gt;TINYINT(1)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　是否启用，0否1是（NOT NULL，默认 1）&lt;/span&gt;&lt;br&gt;&lt;b&gt;status&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　配置状态：active/disabled/archived；enabled=启用；disabled=停用（NOT NULL，默认 &amp;#x27;active&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;misfire_policy&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　错过策略（NOT NULL，默认 &amp;#x27;fire_once_now&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;max_retries&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　最大重试次数（NOT NULL，默认 3）&lt;/span&gt;&lt;br&gt;&lt;b&gt;config_hash&lt;/b&gt; &lt;span style='color:#2563eb'&gt;CHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　规范化配置摘要（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;config_version&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　配置收敛版本（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;last_reconciled_at&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　最近对账时间（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;metadata&lt;/b&gt; &lt;span style='color:#2563eb'&gt;JSON NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　扩展信息（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;create_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　创建时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;update_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　更新时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;deleted&lt;/b&gt; &lt;span style='color:#2563eb'&gt;TINYINT(1)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　删除标记，0未删除，1已删除（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;task_type&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　任务类型（NOT NULL，默认 &amp;#x27;agent_prompt&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;task_payload&lt;/b&gt; &lt;span style='color:#2563eb'&gt;LONGTEXT NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　白名单任务载荷 JSON（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;run_as_role_code&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　固化执行角色（NULL）&lt;/span&gt;&lt;hr&gt;&lt;b&gt;约束与索引&lt;/b&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;PK(id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_schedule_config_id(config_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_schedule_config_owner(owner_user_id, create_time)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_schedule_config_run_as(run_as_user_id, enabled, status)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_schedule_config_tenant_visibility(tenant_id, visibility, status)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_schedule_config_agent(agent_name)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_schedule_config_reconcile(last_reconciled_at, id)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=14;align=left;verticalAlign=top;spacing=18;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="55" y="305" width="1120" height="1382" as="geometry" />
        </mxCell>
        <mxCell id="purpose_agent_schedule_task" value="&lt;div style='text-align:left;line-height:1.55'&gt;&lt;b style='font-size:20px'&gt;agent_schedule_task&lt;/b&gt;&lt;br&gt;&lt;b&gt;这张表解决什么：&lt;/b&gt;保存调度器实际执行的配置快照、下次触发时间、Lease 和重试状态。&lt;br&gt;&lt;b&gt;谁写入：&lt;/b&gt;调度配置 Reconciler　　&lt;b&gt;谁读取：&lt;/b&gt;定时扫描器和调度 Worker&lt;br&gt;&lt;b&gt;关键生命周期：&lt;/b&gt;ready → running → ready；失败 retry；停用 disabled；租约过期可接管&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;align=left;verticalAlign=middle;spacing=16;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1245" y="125" width="1120" height="150" as="geometry" />
        </mxCell>
        <mxCell id="table_agent_schedule_task" value="&lt;div style='text-align:left;line-height:1.45'&gt;&lt;b style='font-size:21px'&gt;agent_schedule_task&lt;/b&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;agent_schedule_task&lt;/span&gt;&lt;hr&gt;&lt;b&gt;字段&lt;/b&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT UNSIGNED&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[PK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　主键（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;tenant_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租户业务ID，个体户可为空（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;user_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　任务归属用户ID，一般等于 run_as_user_id（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;config_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK] [REF]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　调度配置业务ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;task_id&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　调度任务实例ID（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;business_key&lt;/b&gt; &lt;span style='color:#2563eb'&gt;CHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;[UK]&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租户与配置稳定业务键（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;config_hash&lt;/b&gt; &lt;span style='color:#2563eb'&gt;CHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　当前配置摘要（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;config_version&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　运行态配置版本（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;cron_expr&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(128)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　Cron 快照（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;timezone&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(64)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　时区快照（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;misfire_policy&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　错过策略快照（NOT NULL，默认 &amp;#x27;fire_once_now&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;max_retries&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　最大重试次数快照（NOT NULL，默认 3）&lt;/span&gt;&lt;br&gt;&lt;b&gt;planned_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　计划执行时间（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;next_fire_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　下一计划时间 UTC（NOT NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;last_planned_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　上一计划时间 UTC（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;retry_at&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　失败重试时间 UTC（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;status&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(32)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　任务状态：pending/running/success/failed/canceled；ready/running/retry/disabled（NOT NULL，默认 &amp;#x27;pending&amp;#x27;）&lt;/span&gt;&lt;br&gt;&lt;b&gt;retry_count&lt;/b&gt; &lt;span style='color:#2563eb'&gt;INT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　已重试次数（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;lease_owner&lt;/b&gt; &lt;span style='color:#2563eb'&gt;VARCHAR(160)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租约持有者（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;lease_until&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　租约截止时间 UTC（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;fencing_token&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　单调栅栏令牌（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;row_version&lt;/b&gt; &lt;span style='color:#2563eb'&gt;BIGINT NOT&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　行版本（NOT NULL，默认 0）&lt;/span&gt;&lt;br&gt;&lt;b&gt;metadata&lt;/b&gt; &lt;span style='color:#2563eb'&gt;JSON NULL&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　扩展信息（NULL）&lt;/span&gt;&lt;br&gt;&lt;b&gt;create_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　创建时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;update_time&lt;/b&gt; &lt;span style='color:#2563eb'&gt;DATETIME(3)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　更新时间（NOT NULL，默认 CURRENT_TIMESTAMP(3)）&lt;/span&gt;&lt;br&gt;&lt;b&gt;deleted&lt;/b&gt; &lt;span style='color:#2563eb'&gt;TINYINT(1)&lt;/span&gt; &lt;span style='color:#7c3aed'&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='color:#4b5563'&gt;　删除标记，0未删除，1已删除（NOT NULL，默认 0）&lt;/span&gt;&lt;hr&gt;&lt;b&gt;约束与索引&lt;/b&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;PK(id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_schedule_task_id(task_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_schedule_task_config(config_id)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;UK uk_schedule_task_business(business_key)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_schedule_task_user(user_id, planned_time)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_schedule_task_config(config_id, planned_time)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_schedule_task_status(status, planned_time)&lt;/span&gt;&lt;br&gt;&lt;span style='color:#6b7280'&gt;IDX idx_schedule_task_due(status, retry_at, next_fire_time, lease_until)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=14;align=left;verticalAlign=top;spacing=18;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="1245" y="305" width="1120" height="1492" as="geometry" />
        </mxCell>
