{
  "name": "ai-agent-scaffold-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "test:unit": "esbuild tests/workflow-event-reducer.test.mjs --bundle --platform=node --format=cjs --alias:@=./src --outfile=/tmp/ai-agent-workflow-event-test.cjs && esbuild tests/workflow-templates.test.mjs --bundle --platform=node --format=cjs --alias:@=./src --outfile=/tmp/ai-agent-workflow-template-test.cjs && node --test /tmp/ai-agent-workflow-event-test.cjs /tmp/ai-agent-workflow-template-test.cjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@lucide/vue": "^1.23.0",
    "@vueuse/core": "^13.5.0",
    "axios": "^1.10.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vue-tsc": "^2.2.10"
  }
}
